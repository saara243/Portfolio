---
/** Encabezado de sección: slugline de guion en Courier (INT. LUGAR — DÍA) + título. */
interface Props {
  scene: string;
  title?: string;
  level?: 1 | 2;
  align?: 'start' | 'center';
  size?: 'md' | 'lg';
  /** La slugline se teclea y el título entra con un corte al llegar a pantalla (ver RevealOnScroll). */
  reveal?: boolean;
}

const { scene, title, level = 2, align = 'start', size = 'md', reveal = false } = Astro.props;
const Heading = level === 1 ? 'h1' : 'h2';
---

<div class:list={['scene', `scene--${align}`, `scene--${size}`]} data-reveal={reveal ? '' : undefined}>
  <p class:list={['scene__slug script-font', { 'reveal-type': reveal }]} style={reveal ? `--chars:${scene.length}` : undefined}>{scene}</p>
  {title && <Heading class:list={['scene__title', { 'reveal-line': reveal }]}>{title}</Heading>}
</div>

<style>
  .scene {
    margin-bottom: var(--space-12);
  }

  .scene--center {
    text-align: center;
  }

  .scene--center .scene__slug {
    margin-inline: auto;
  }

  .scene__slug {
    margin: 0 0 var(--space-3);
    font-weight: 700;
    font-size: var(--text-sm);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .scene__title {
    margin: 0;
    font-size: var(--text-2xl);
  }

  .scene--lg .scene__title {
    font-size: var(--text-3xl);
  }
</style>
