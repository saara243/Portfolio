---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Motif from '../../components/Motif.astro';
import SceneHeading from '../../components/SceneHeading.astro';
import SkillGroups from '../../components/SkillGroups.astro';
import { profileModule } from '../../modules/profile/application/factory';
import { getLangStaticPaths, localizedPath, routes, toLang, useTranslations, withBase } from '../../i18n/utils';

export const getStaticPaths = getLangStaticPaths;

const lang = toLang(Astro.params.lang);
const t = useTranslations(lang);
const profile = await profileModule.getProfile.execute({ locale: lang });
const photo = profile.getPhoto();
const experience = profile.getExperience();
const learnings = profile.getLearnings();
const pathNote = profile.getPathNote();
const skillsNote = profile.getSkillsNote();
---

<BaseLayout lang={lang} path={routes.about} title={t('about.title')}>
  <section class="band about" data-tone="peach">
    <div class="container about__inner">
      {photo && (
        <figure class="about__figure">
          <img class="about__photo" src={withBase(photo)} alt={t('about.photoAlt')} width="840" height="1050" />
          <Motif kind="sparkle" size="3rem" class="about__spark" />
        </figure>
      )}
      <div class="about__text">
        <SceneHeading scene={t('scene.about')} title={t('about.title')} level={1} size="lg" />
        <div class="prose about__bio" set:html={profile.getBioHtml()} />
      </div>
    </div>
  </section>

  {(experience.length > 0 || learnings.length > 0) && (
    <section class="band path" data-tone="cobalt">
      <div class="container">
        <p class="path__slug script-font">{t('scene.studies')}</p>
        {pathNote && <p class="path__note">{pathNote}</p>}
        <div class="path__grid">
          {experience.length > 0 && (
            <section class="path__panel" data-tone="peach">
              <Motif kind="badge" size="3.5rem" class="path__mark" />
              <h2 class="path__title">{t('about.experience')}</h2>
              <ul class="path__list">
                {experience.map((entry) => (
                  <li>
                    <span class="path__entry">{entry.getTitle()}</span>
                    {entry.getPlace() && <span class="path__place">{entry.getPlace()}</span>}
                    {entry.getDescription() && <span class="path__desc">{entry.getDescription()}</span>}
                    {entry.getPeriod() && <span class="path__period">{entry.getPeriod()}</span>}
                  </li>
                ))}
              </ul>
              <a class="button path__cv" href={localizedPath(lang, routes.cv)}>{t('about.fullCv')} <span aria-hidden="true">→</span></a>
            </section>
          )}
          {learnings.length > 0 && (
            <section class="path__panel" data-tone="peach">
              <Motif kind="badge" size="3.5rem" class="path__mark" />
              <h2 class="path__title">{t('about.learnings')}</h2>
              <ul class="path__list">
                {learnings.map((learning) => (
                  <li>
                    <span class="path__entry">{learning}</span>
                  </li>
                ))}
              </ul>
            </section>
          )}
        </div>
      </div>
    </section>
  )}

  {profile.getSkills().length > 0 && (
    <section class="band" data-tone="taupe">
      <div class="container">
        <SceneHeading scene={t('scene.skills')} title={t('about.contribute')} align="center" size="lg" />
        <SkillGroups groups={profile.getSkills()} lang={lang} />
        {skillsNote && (
          <p class="skills-note">
            <Motif kind="sparkle" size="1.25rem" class="skills-note__mark" />
            <span>{skillsNote}</span>
            <Motif kind="sparkle" size="1.25rem" class="skills-note__mark" />
          </p>
        )}
      </div>
    </section>
  )}


  {profile.getLanguages().length > 0 && (
    <section class="band" data-tone="peach">
      <div class="container">
        <h2 class="languages__title">{t('about.languages')}</h2>
        <ul class="tags">{profile.getLanguages().map((language) => <li>{language}</li>)}</ul>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .about__inner {
    display: grid;
    gap: var(--space-12);
  }

  .about__figure {
    position: relative;
    margin: 0;
    max-width: 22rem;
  }

  .about__photo {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    rotate: -2deg;
    outline: 1px solid var(--line);
    outline-offset: 10px;
  }

  .about__figure :global(.about__spark) {
    position: absolute;
    right: -1.25rem;
    top: -1.25rem;
    color: var(--cobalt);
  }

  .about__bio {
    max-width: 62ch;
    font-size: var(--text-lg);
    font-weight: 300;
  }

  .path__slug {
    margin: 0 0 var(--space-8);
    font-weight: 700;
    font-size: var(--text-sm);
    text-transform: uppercase;
    text-align: center;
  }

  .path__note {
    max-width: 46ch;
    margin: calc(-1 * var(--space-4)) auto var(--space-12);
    font-family: var(--font-display);
    font-weight: 300;
    font-style: italic;
    font-size: var(--text-xl);
    line-height: 1.4;
    text-align: center;
    text-wrap: balance;
  }

  .path__cv {
    margin-top: var(--space-8);
    white-space: nowrap;
  }

  @media (max-width: 479px) {
    .path__cv {
      padding-inline: var(--space-4);
      letter-spacing: 0.08em;
    }
  }

  .path__grid {
    display: grid;
    gap: var(--space-4);
  }

  .path__panel {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: var(--space-4);
    padding: clamp(2rem, 1.5rem + 3vw, 3.5rem) clamp(1.25rem, 1rem + 2vw, 3rem);
    text-align: center;
  }

  .path__panel :global(.path__mark) {
    color: var(--accent);
  }

  .path__title {
    margin: 0;
    font-size: var(--text-2xl);
  }

  .path__list {
    display: grid;
    gap: var(--space-6);
    margin: var(--space-2) 0 var(--space-4);
    padding: 0;
    list-style: none;
  }

  .path__list li {
    display: grid;
    gap: var(--space-1);
  }

  .path__entry {
    font-size: var(--text-lg);
    font-weight: 400;
    line-height: 1.4;
    text-wrap: balance;
  }

  .path__place,
  .path__period {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .path__place {
    color: var(--accent);
  }

  .path__desc {
    max-width: 38ch;
    margin-inline: auto;
    font-weight: 300;
  }

  .languages__title {
    font-size: var(--text-xl);
  }

  @media (min-width: 900px) {
    .about__inner {
      grid-template-columns: minmax(16rem, 2fr) 3fr;
      align-items: start;
      gap: var(--space-16);
    }

    .about__figure {
      position: sticky;
      top: 8rem;
      margin-top: var(--space-16);
    }

    .path__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Cierre de «¿Qué puedo aportar?»: la frase va dentro de la misma banda, bajo los sobres. */
  .skills-note {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    margin: clamp(3rem, 2rem + 3vw, 5rem) auto 0;
    font-family: var(--font-display);
    font-weight: 300;
    font-style: italic;
    font-size: var(--text-xl);
    line-height: 1.35;
    text-align: center;
    text-wrap: balance;
    color: var(--heading);
  }

  /* En una sola línea desde tablet; en móvil puede partirse. */
  @media (min-width: 768px) {
    .skills-note span {
      white-space: nowrap;
    }
  }

  .skills-note :global(.skills-note__mark) {
    color: var(--accent);
  }
</style>
