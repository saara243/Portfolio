---
import { LOCALES, languages, localizedPath, useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  path: string;
}

const { lang, path } = Astro.props;
const t = useTranslations(lang);
---

<ul class="lang" aria-label={t('a11y.language')}>
  {LOCALES.map((locale) => (
    <li>
      <a
        href={localizedPath(locale, path)}
        hreflang={languages[locale].htmlLang}
        lang={languages[locale].htmlLang}
        aria-current={locale === lang ? 'true' : undefined}
        title={languages[locale].label}
      >
        {languages[locale].short}
      </a>
    </li>
  ))}
</ul>

<style>
  .lang {
    display: flex;
    gap: var(--space-1);
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-script);
    font-size: var(--text-sm);
  }

  .lang a {
    display: inline-grid;
    place-items: center;
    min-width: 44px;
    min-height: 44px;
    text-decoration: none;
    color: var(--color-muted);
  }

  .lang a[aria-current='true'] {
    color: var(--color-ink);
    font-weight: 700;
  }
</style>
