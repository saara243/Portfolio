5 315.3Q196.8 315.5 196.8 315.7Q196.8 315.9 196.6 316.1Q196.5 316.4 196.4 316.5Q196.2 316.7 196 316.9Q195.8 317.2 195.7 317.3Q195.7 317.4 195.6 317.6Q195.5 317.8 195.3 318Q195.2 318.1 195.2 318.4Q195.2 318.6 195.5 319.4Q195.8 320.2 195.8 320.5Q195.8 320.9 194.4 322.2Q193 323.6 193 324.4Q193 324.9 193.4 324.9Q193.9 324.9 195.3 323.9L195.8 323.6Q198.3 321.9 200.4 320.2M210.1 320.3L211 319.5Q211.3 319.3 211.5 319.3Q211.7 319.3 211.7 319.6L211.7 319.7Q207.8 322.9 205.2 324.6Q202.5 326.2 200.4 326.2Q198.7 326.2 198.7 324.5Q198.7 322.1 201.2 319.5Q203.7 316.9 205.4 316.9Q206.4 316.9 206.4 317.9Q206.2 320 200.4 323.5L200.4 323.9Q200.4 325.2 201.7 325.2Q203 325.2 204.5 324.3Q207.5 322.6 210.1 320.3M204.4 318Q203.6 318 202.3 319.4Q201 320.8 200.5 322.6Q202.3 321.5 203.6 320.3Q204.8 319.1 204.8 318.5Q204.8 318 204.4 318M211.8 325.3Q211.8 324.8 212.4 323.8Q212.9 322.9 212.9 322.8Q213 322.6 212.9 322.6Q212.8 322.6 212.5 322.8Q212.3 323 210.2 324.4Q208.1 325.8 207.3 325.8Q206.8 325.8 206.8 325.1Q206.8 324.5 208.9 321.6Q211 318.8 211.9 318.8Q212.1 318.8 212.3 318.9Q212.4 319.1 212.4 319.2Q212.4 319.3 210.5 321.5Q208.5 323.8 208.5 324.4Q208.5 324.6 208.7 324.6Q209.4 324.6 211.8 322.6Q214.2 320.7 215.2 319.6Q216.2 318.6 216.8 318.6Q217.4 318.6 217.4 319.1Q217.4 319.4 217.1 319.7Q216.9 320 216.3 320.7Q215.6 321.5 215.1 322.2Q213.6 324.1 213.6 324.6Q213.6 325.1 214 325.1Q214.4 325.1 216 324Q218.9 322.1 221.3 320.2L222.1 319.5Q222.4 319.3 222.6 319.3Q222.7 319.3 222.7 319.5L222.7 319.6Q222.9 319.6 220.7 321.3Q218.5 323 216 324.6Q213.6 326.3 212.9 326.3Q211.8 326.3 211.8 325.3" />

      <g class="contract__seal">
        <path d={badge} fill="var(--cobalt)" />
        <path d={sparkle} fill="var(--peach)" />
      </g>
    </g>

    <g class="contract__pen">
      <path d="M0 0l7-3 34-34a4 4 0 0 0-6-6L1-9Z" fill="var(--peach)" stroke="var(--cobalt)" stroke-width="2" />
      <path d="M30-38l6 6" stroke="var(--cobalt)" stroke-width="2" />
    </g>
  </svg>
</div>

<script>
  // El contrato solo se anima mientras está a la vista.
  function initContract() {
    const contract = document.querySelector<HTMLElement>('[data-contract]');
    if (!contract || !('IntersectionObserver' in window)) return;
    const observer = new IntersectionObserver(([entry]) => contract.toggleAttribute('data-playing', entry.isIntersecting));
    observer.observe(contract);
    document.addEventListener('astro:before-swap', () => observer.disconnect(), { once: true });
  }

  document.addEventListener('astro:page-load', initContract);
</script>

<style>
  .contract {
    width: 100%;
    rotate: -3deg;
  }

  .contract__svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .contract :global(*) {
    transform-box: fill-box;
    transform-origin: center;
  }

  .contract__sub {
    font-family: var(--font-display);
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    fill: var(--cobalt);
  }

  .contract__label {
    font-family: var(--font-script);
    font-size: 9px;
    fill: var(--ink);
  }

  .contract__clause {
    stroke: var(--cobalt);
    stroke-width: 3.5;
    stroke-opacity: 0.35;
  }

  .contract__sig {
    fill: var(--cobalt);
    stroke: var(--cobalt);
    stroke-width: 0.6;
  }

  .contract .contract__ink {
    transform-box: view-box;
    transform-origin: 60px 0;
  }

  .contract__seal {
    rotate: -14deg;
    opacity: 0.92;
  }

  .contract__pen {
    opacity: 0;
    transform-box: view-box;
    transform-origin: 0 0;
    translate: 268px 318px;
  }

  .contract:not([data-playing]) :global(*) {
    animation-play-state: paused !important;
  }

  @media (prefers-reduced-motion: no-preference) {
    .contract__paper {
      animation: contract-jolt 9s ease-out infinite;
    }

    .contract__clause {
      stroke-dasharray: 1;
      animation: contract-clause 9s ease-out infinite;
      animation-delay: calc(var(--i) * 0.28s);
    }

    .contract__ink {
      animation: contract-sign 9s linear infinite;
    }

    .contract__sig {
      animation: contract-sig-fade 9s linear infinite;
    }

    .contract__pen {
      animation: contract-pen 9s ease-in-out infinite;
    }

    .contract__seal {
      animation: contract-stamp 9s var(--ease-out) infinite;
    }
  }

  /* Cláusulas: se escriben al principio y se borran al final del ciclo. */
  @keyframes contract-clause {
    0% { stroke-dashoffset: 1; opacity: 1; }
    8%, 88% { stroke-dashoffset: 0; opacity: 1; }
    96%, 100% { stroke-dashoffset: 0; opacity: 0; }
  }

  /* La tinta aparece de izquierda a derecha, al ritmo de la pluma. */
  @keyframes contract-sign {
    0%, 40% { scale: 0 1; }
    58%, 100% { scale: 1 1; }
  }

  @keyframes contract-sig-fade {
    0%, 88% { opacity: 1; }
    96%, 100% { opacity: 0; }
  }

  /* La pluma entra, sigue la firma de izquierda a derecha y sale. */
  @keyframes contract-pen {
    0%, 36% { opacity: 0; translate: 110px 270px; rotate: 0deg; }
    40% { opacity: 1; translate: 82px 318px; rotate: 0deg; }
    44% { translate: 104px 304px; rotate: -6deg; }
    48% { translate: 132px 318px; rotate: 4deg; }
    52% { translate: 162px 304px; rotate: -6deg; }
    55% { translate: 192px 316px; rotate: 4deg; }
    58% { translate: 218px 310px; rotate: 0deg; opacity: 1; }
    64%, 100% { translate: 250px 280px; opacity: 0; }
  }

  /* Sello: cae de arriba con un golpe seco y se queda. */
  @keyframes contract-stamp {
    0%, 63% { opacity: 0; scale: 2.2; rotate: -30deg; }
    68% { opacity: 0.92; scale: 1; rotate: -14deg; }
    71% { scale: 1.08; }
    74%, 88% { opacity: 0.92; scale: 1; rotate: -14deg; }
    96%, 100% { opacity: 0; scale: 1; rotate: -14deg; }
  }

  /* La hoja da un respingo cuando cae el sello. */
  @keyframes contract-jolt {
    0%, 67% { translate: 0 0; }
    69% { translate: 0 3px; }
    72%, 100% { translate: 0 0; }
  }
</style>
