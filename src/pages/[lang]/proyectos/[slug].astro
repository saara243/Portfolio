---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CoverArt from '../../../components/CoverArt.astro';
import DownloadButton from '../../../components/DownloadButton.astro';
import SceneHeading from '../../../components/SceneHeading.astro';
import { profileModule } from '../../../modules/profile/application/factory';
import { scriptsModule } from '../../../modules/scripts/application/factory';
import type { UiKey } from '../../../i18n/ui';
import { LOCALES, localizedPath, routes, toLang, useTranslations, withBase } from '../../../i18n/utils';

export const getStaticPaths = (async () => {
  const paths = await Promise.all(
    LOCALES.map(async (lang) => {
      const scripts = await scriptsModule.listScripts.execute({ locale: lang });
      return scripts.toArray().map((script) => ({ params: { lang, slug: script.getSlug() } }));
    }),
  );
  return paths.flat();
}) satisfies GetStaticPaths;

const lang = toLang(Astro.params.lang);
const t = useTranslations(lang);
const script = await scriptsModule.getScriptBySlug.execute({ locale: lang, slug: Astro.params.slug! });
const profile = await profileModule.getProfile.execute({ locale: lang });

const cover = script.getCover();
const coverArt = script.getCoverArt();
const pdf = script.getPdf();
const requestHref = `mailto:${profile.getEmail()}?subject=${encodeURIComponent(
  `${t('script.onRequestSubject')}: ${script.getTitle()}`,
)}`;

const details = [
  { label: t('script.format'), value: t(`format.${script.getFormat().getValue()}` as UiKey) },
  { label: t('script.genres'), value: script.getGenres().map((genre) => genre.getLabel()).join(', ') },
  { label: script.getDate() ? t('script.date') : t('script.year'), value: script.getDisplayDate() },
  { label: t('script.pages'), value: script.getPages() },
  { label: t('script.duration'), value: script.getDuration() },
  { label: t('script.status'), value: t(`status.${script.getStatus().getValue()}` as UiKey) },
].filter((detail) => detail.value !== undefined && detail.value !== '');
---

<BaseLayout
  lang={lang}
  path={routes.project(script.getSlug())}
  title={script.getTitle()}
  description={script.getLogline()}
  image={cover}
>
  <article class="band" data-tone="peach">
    <div class="container script">
      <a class="script__back" href={localizedPath(lang, routes.projects)}><span aria-hidden="true">←</span> {t('projects.back')}</a>

      <div class="script__layout">
        <div class="script__main">
          <SceneHeading scene={t('scene.script')} title={script.getTitle()} level={1} size="lg" />

          <section class="script__logline">
            <h2 class="script__label script-font">{t('script.logline')}</h2>
            <p>{script.getLogline()}</p>
          </section>

          {script.getSynopsisHtml() && (
            <section class="script__block">
              <h2 class="script__label script-font">{t('script.synopsis')}</h2>
              <div class="prose script__synopsis" set:html={script.getSynopsisHtml()} />
            </section>
          )}

          {script.getContext() && (
            <section class="script__block">
              <h2 class="script__label script-font">{t('script.context')}</h2>
              <div class="prose script__synopsis"><p>{script.getContext()}</p></div>
            </section>
          )}

          {script.getAwards().length > 0 && (
            <section class="script__block">
              <h2 class="script__label script-font">{t('script.awards')}</h2>
              <ul class="script__awards">{script.getAwards().map((award) => <li>{award}</li>)}</ul>
            </section>
          )}
        </div>

        <aside class="script__aside">
          {cover && (
            <img
              class="script__cover"
              src={withBase(cover)}
              alt=""
              width="600"
              height="800"
              transition:name={`cover-${script.getSlug()}`}
            />
          )}
          {!cover && coverArt && (
            <CoverArt kind={coverArt} title={script.getTitle()} class="script__cover" transition:name={`cover-${script.getSlug()}`} />
          )}
          <div class="script__sheet" data-tone="taupe">
            <h2 class="script__label script-font">{t('script.details')}</h2>
            <dl class="script__details">
              {details.map((detail) => (
                <div>
                  <dt>{detail.label}</dt>
                  <dd>{detail.value}</dd>
                </div>
              ))}
            </dl>

            {script.getFiles().length > 0 && script.isPublic() ? (
              <div class="script__files">
                {script.getFiles().map((doc, i) => (
                  <DownloadButton file={doc.file} label={doc.label} variant={i === 0 ? 'primary' : 'secondary'} />
                ))}
              </div>
            ) : (
              script.isDownloadable() && pdf && <DownloadButton file={pdf} label={t('script.download')} />
            )}
            {script.isAvailableOnRequest() && (
              <>
                <p class="script__note">{t('script.onRequestNote')}</p>
                <a class="button button--primary" href={requestHref}>{t('script.onRequest')}</a>
              </>
            )}
          </div>
        </aside>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .script__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    margin-bottom: var(--space-8);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--accent);
  }

  .script__layout {
    display: grid;
    gap: var(--space-16);
  }

  .script__label {
    margin: 0 0 var(--space-4);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--accent);
  }

  .script__logline p {
    max-width: 36ch;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: var(--text-xl);
    line-height: 1.4;
  }

  .script__block {
    margin-top: var(--space-16);
  }

  .script__synopsis {
    max-width: 62ch;
    font-weight: 300;
    font-size: var(--text-lg);
  }

  .script__awards {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .script__awards li {
    position: relative;
    padding-left: var(--space-6);
  }

  .script__awards li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.8em;
    width: 0.75rem;
    height: 1px;
    background: var(--accent);
  }

  .script__cover {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }

  .script__files {
    display: grid;
    justify-items: start;
    gap: var(--space-3);
  }

  .script__sheet {
    padding: var(--space-8);
  }

  .script__details {
    display: grid;
    margin: 0 0 var(--space-8);
    border-top: 1px solid var(--line);
  }

  .script__details div {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--line);
  }

  .script__details dt {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    line-height: 1.9;
  }

  .script__details dd {
    margin: 0;
  }

  .script__note {
    font-size: var(--text-sm);
  }

  @media (min-width: 900px) {
    .script__layout {
      grid-template-columns: minmax(0, 7fr) minmax(18rem, 4fr);
      align-items: start;
      gap: var(--space-24);
    }

    .script__aside {
      position: sticky;
      top: 7rem;
    }
  }
</style>
