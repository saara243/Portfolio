    .ck-kids {
      animation: ck-taken 10s ease-in infinite;
    }

    .ck-eye {
      animation: ck-eye 10s ease-out infinite;
    }

    .ck-closet {
      animation: ck-slam 10s linear infinite;
    }

    /* Halitosis */
    .cd-stink {
      animation: cd-stink 1.8s ease-out var(--s) infinite;
    }

    .cd-lasso {
      animation: cd-lasso 8s ease-in-out infinite;
    }

    .cd-tube {
      animation: cd-tube 8s steps(1, end) infinite;
    }

    .cd-shard {
      animation: cd-shard 8s ease-in var(--d) infinite;
    }

    .cd-fountain {
      animation: cd-fountain 8s steps(1, end) infinite;
    }

    .cd-drop {
      animation: cd-drop 1s ease-in-out var(--d) infinite;
    }

    .cd-jar {
      animation: cd-jar 8s var(--ease-out) infinite;
    }

    .cd-candy {
      animation: cd-candy 8s linear infinite;
    }

    /* Cifras y letras */
    .ct-letters {
      animation: ct-letters 8s steps(1, end) infinite;
    }

    .ct-tile {
      animation: ct-tile 8s var(--ease-out) var(--t) infinite;
    }

    .ct-timer {
      animation: ct-timer 8s linear infinite;
    }

    .ct-vacuum {
      animation: ct-vacuum 8s var(--ease-out) infinite;
    }

    .ct-tv {
      animation: ct-shake 8s linear infinite;
    }

    .ct-antenna {
      animation: ct-antenna 8s ease-out infinite;
    }

    .ct-static {
      animation: ct-static 8s linear infinite;
    }

    .ct-crack,
    .ct-face {
      animation: ct-after 8s steps(1, end) infinite;
    }

    .ct-eye {
      animation: ct-spin 1.2s linear infinite;
    }

    /* Plató */
    .cs-bulb {
      animation: cs-bulb 0.8s steps(1, end) var(--b) infinite;
    }

    .cs-spot--l {
      animation: cs-sweep 4s ease-in-out infinite alternate;
    }

    .cs-spot--r {
      animation: cs-sweep 4s ease-in-out -2s infinite alternate-reverse;
    }

    .cs-dancer {
      animation: cs-sway 2s ease-in-out infinite;
    }

    .cs-arm {
      animation: cs-arm 1s ease-in-out infinite alternate;
    }

    .cs-arm--r {
      animation-delay: -0.5s;
    }

    .cs-skirt {
      animation: cs-twirl 8s ease-in-out infinite;
    }

    .cs-camera {
      animation: cs-pan 8s ease-in-out infinite;
    }

    .cs-rec {
      animation: cs-bulb 1.2s steps(1, end) infinite;
    }

    .cs-kid {
      animation: cs-kid 8s ease-out infinite;
    }

    .cs-wave {
      animation: cs-wave 0.5s ease-in-out infinite alternate;
    }
  }

