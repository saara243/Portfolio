---
/**
 * Portada ilustrada y animada para guiones sin imagen (campo `coverArt` del guion).
 * - revival («Los conflictos de estar vivo y muerto a la vez»): la tarta de cumpleaños de mamá
 *   tiembla, el hermano muerto sale de dentro con el piso de arriba (y las velas) de sombrero,
 *   ojos en X, canta con manos de jazz y suelta notas; las dos hermanas, opuestas (alta y rellena /
 *   bajita y en trazo), saltan del susto. Vuelve a hundirse. Bucle de 8 s, pausado fuera de pantalla.
 * - set («Último casting»): el plató de ¡Baila, Baila! — rótulo con bombillas que corren, focos que
 *   barren el escenario, una bailarina con vestido de cuadros que gira, la cámara grabando (REC) y, en
 *   la grada, la silla vacía donde aparece Carmen de niña y saluda. Bucle de 8 s.
 * - tube («Cifras y letras»): la tele de tubo con las fichas del concurso y la barra del tiempo; entra
 *   el tubo de la aspiradora, golpe, la pantalla se agrieta y dentro aparece Yolanda mareada. Bucle de 8 s.
 * - dentist («Un problema de halitosis»): Diego en el sillón del dentista, con pantalones de campana y el
 *   aliento echando humo; hace girar el grifo como un lazo, revienta el fluorescente (caen cristales), el
 *   grifo se vuelve fuente y del bote cae un caramelo que rebota hasta él. Bucle de 8 s.
 * Decorativo (aria-hidden): el título real va en la tarjeta. Sin movimiento, queda la escena con él fuera.
 */
interface Props {
  kind: 'revival' | 'set' | 'tube' | 'dentist';
  title: string;
  class?: string;
  [attr: string]: unknown;
}

const { kind, title, class: className, ...rest } = Astro.props;

// Título de cartel: lo que va tras la última coma es el subtítulo («el musical»).
const comma = title.lastIndexOf(',');
const main = comma > 0 ? title.slice(0, comma) : title;
const sub = comma > 0 ? title.slice(comma + 1).trim() : '';
const lines: string[] = [];
for (const word of main.split(/\s+/)) {
  const last = lines.at(-1);
  if (last !== undefined && (last + ' ' + word).length <= 17) lines[lines.length - 1] = `${last} ${word}`;
  else lines.push(word);
}

const candles = [125, 150, 175];
const notes = [
  { x: 76, y: 236, d: 0 },
  { x: 226, y: 222, d: 0.35 },
  { x: 62, y: 196, d: 0.7 },
  { x: 238, y: 182, d: 1.05 },
];
const fingers = [-60, -30, 0, 30, 60];

// Plató: bombillas del rótulo y sillas de la grada (la vacía, `kid`, es donde aparece Carmen niña).
const bulbs = Array.from({ length: 10 }, (_, i) => 78 + i * 16);
// Concurso: fichas de letras en dos filas.
const tiles = [...'CIFRAS', ...'LETRAS'].map((letter, i) => ({ letter, x: 86 + (i % 6) * 18, y: i < 6 ? 170 : 196, i }));
const cracks = 'M168 184l-14-20M168 184l22-14M168 184l-6 26M168 184l-30 8M168 184l18 16M154 164l-8-6M190 170l6-10M138 192l-8 8';

// Dentista: cristales del fluorescente y gotas de la fuente.
const shards = [
  { x: 132, r: -120, d: 0 },
  { x: 150, r: 160, d: 0.05 },
  { x: 166, r: -200, d: 0.1 },
  { x: 182, r: 140, d: 0.03 },
];
const drops = [
  { dx: -16, h: 70, d: 0 },
  { dx: 4, h: 92, d: 0.25 },
  { dx: 20, h: 64, d: 0.5 },
  { dx: -6, h: 82, d: 0.75 },
];

const seats = [
  { x: 44, y: 362, kid: true },
  { x: 82, y: 362 },
  { x: 120, y: 362 },
  { x: 158, y: 362 },
];
---

<div class:list={['cv', `cv--${kind}`, className]} data-cover-art aria-hidden="true" {...rest}>
  <svg viewBox="0 0 300 400" fill="none" stroke-linecap="round" stroke-linejoin="round">
    <rect width="300" height="400" fill="var(--cobalt)" />

    <g class="cv-title">
      {lines.map((line, i) => (
        <text x="150" y={48 + i * 26} text-anchor="middle">{line}</text>
      ))}
      {sub && <text class="cv-sub" x="150" y={48 + lines.length * 26 + 2} text-anchor="middle">— {sub} —</text>}
    </g>

    {kind === 'revival' && (<>
    <!-- Notas que suelta al cantar -->
    {notes.map((note) => (
      <g transform={`translate(${note.x} ${note.y})`}>
        <g class="cv-note" style={`--d:${note.d}s`}>
          <circle cx="0" cy="0" r="4" fill="var(--peach)" />
          <path d="M4 0V-16q7 3 6 10" stroke="var(--peach)" stroke-width="2" />
        </g>
      </g>
    ))}

    <!-- El hermano (detrás de la tarta), con el piso de arriba como sombrero -->
    <g class="cv-rise">
      <path d="M118 270v-18q0-14 16-16h32q16 2 16 16v18Z" fill="var(--peach)" />
      <path d="M150 240l-10-6v12Zm0 0l10-6v12Z" fill="var(--cobalt)" />

      {[-1, 1].map((side) => (
        <g class:list={['cv-arm', side < 0 ? 'cv-arm--l' : 'cv-arm--r']}>
          <path d={`M${150 + side * 26} 248q${side * 18}-6 ${side * 24}-30`} stroke="var(--peach)" stroke-width="6" />
          <g class="cv-hand">
            <circle cx={150 + side * 50} cy="212" r="7" fill="var(--peach)" />
            {fingers.map((a) => {
              const rad = ((a - 90) * Math.PI) / 180;
              const cx = 150 + side * 50;
              return <path d={`M${cx + Math.cos(rad) * 6} ${212 + Math.sin(rad) * 6}L${cx + Math.cos(rad) * 13} ${212 + Math.sin(rad) * 13}`} stroke="var(--peach)" stroke-width="3" />;
            })}
          </g>
        </g>
      ))}

      <ellipse cx="150" cy="212" rx="26" ry="23" fill="var(--peach)" />
      <path d="M137 203l7 7m0-7l-7 7M156 203l7 7m0-7l-7 7" stroke="var(--cobalt)" stroke-width="2.5" />
      <ellipse class="cv-mouth" cx="150" cy="223" rx="5" ry="3.5" fill="var(--cobalt)" />

      <g class="cv-cap">
        <path d="M95 175h110v13q-5 7-10 0t-12 2-12-2-14 4-12-4-12 2-14-2-12 2-12-2Z" fill="var(--peach-soft)" />
        {candles.map((x, i) => (
          <>
            <rect x={x - 3} y="158" width="6" height="17" fill="var(--peach)" />
            <path d={`M${x - 3} 165l6-3M${x - 3} 171l6-3`} stroke="var(--cobalt)" stroke-width="1.5" />
            <path class="cv-flame" style={`--f:${i * 0.17}s`} d={`M${x} 142q6 8 3.5 12a3.5 3.5 0 0 1-7 0q-2.5-4 3.5-12Z`} fill="var(--peach-soft)" />
          </>
        ))}
      </g>
    </g>

    <!-- La tarta (delante) -->
    <g class="cv-cake">
      <rect x="95" y="262" width="110" height="38" fill="var(--peach)" />
      <path d="M95 262h110" stroke="var(--cobalt)" stroke-opacity="0.35" />
      <circle cx="112" cy="281" r="3" fill="var(--cobalt)" /><circle cx="150" cy="281" r="3" fill="var(--cobalt)" /><circle cx="188" cy="281" r="3" fill="var(--cobalt)" />
      <rect x="70" y="300" width="160" height="60" fill="var(--peach)" />
      <path d="M70 300h160v8q-8 8-16 0t-16 0-16 0-16 0-16 0-16 0-16 0-16 0-16 0-16 0Z" fill="var(--peach-soft)" />
      <text class="cv-cake-text" x="150" y="342" text-anchor="middle">FELIZ CUMPLE MAMÁ</text>
      <path d="M60 362h180" stroke="var(--peach)" stroke-width="3" />
    </g>

    <!-- Las hermanas: opuestas -->
    <g class="cv-sister cv-sister--a">
      <circle cx="38" cy="296" r="9" fill="var(--peach)" />
      <path d="M44 290q10 2 8 14" stroke="var(--peach)" stroke-width="3" />
      <path d="M38 307l-12 55h24Z" fill="var(--peach)" />
      <text class="cv-gasp" x="38" y="276" text-anchor="middle">!</text>
    </g>
    <g class="cv-sister cv-sister--b">
      <circle cx="264" cy="324" r="9" stroke="var(--peach)" stroke-width="2.5" />
      <path d="M246 361q0-28 18-28t18 28Z" stroke="var(--peach)" stroke-width="2.5" />
      <path d="M259 323h3m4 0h3" stroke="var(--peach)" stroke-width="2" />
      <text class="cv-gasp" x="264" y="304" text-anchor="middle">!</text>
    </g>
    </>)}

    {kind === 'set' && (<>
      <defs>
        <pattern id="cs-checks" width="8" height="8" patternUnits="userSpaceOnUse">
          <rect width="8" height="8" fill="var(--peach-soft)" />
          <rect width="4" height="4" fill="var(--cobalt)" />
          <rect x="4" y="4" width="4" height="4" fill="var(--cobalt)" />
        </pattern>
      </defs>

      <!-- Focos que barren el escenario -->
      {[-1, 1].map((side) => (
        <g class:list={['cs-spot', side < 0 ? 'cs-spot--l' : 'cs-spot--r']}>
          <path d={`M${150 + side * 112} 126L${150 + side * 40} 304H${150 - side * 34}Z`} fill="var(--peach)" opacity="0.16" />
          <path d={`M${150 + side * 104} 116h${side * 16}l${side * 4} 14h${-side * 24}Z`} fill="var(--peach)" />
        </g>
      ))}

      <!-- Rótulo del programa -->
      <rect x="66" y="72" width="168" height="38" rx="4" stroke="var(--peach)" stroke-width="2" />
      <text class="cs-sign" x="150" y="96" text-anchor="middle">¡BAILA, BAILA!</text>
      {bulbs.map((x, i) => (
        <>
          <circle class="cs-bulb" style={`--b:${(i % 2) * 0.4}s`} cx={x} cy="72" r="2.4" fill="var(--peach-soft)" />
          <circle class="cs-bulb" style={`--b:${((i + 1) % 2) * 0.4}s`} cx={x} cy="110" r="2.4" fill="var(--peach-soft)" />
        </>
      ))}

      <!-- Escenario y círculo de luz -->
      <ellipse cx="150" cy="300" rx="54" ry="8" fill="var(--peach-soft)" opacity="0.45" />
      <path d="M24 304h252v10H24Z" fill="var(--peach)" />

      <!-- La bailarina, vestido de cuadros -->
      <g class="cs-dancer">
        <path class="cs-arm cs-arm--l" d="M145 229l-18-14" stroke="var(--peach)" stroke-width="4" />
        <path class="cs-arm cs-arm--r" d="M155 229l18-14" stroke="var(--peach)" stroke-width="4" />
        <path d="M145 284l-4 18M155 284l4 18" stroke="var(--peach)" stroke-width="4" />
        <circle cx="150" cy="210" r="10" fill="var(--peach)" />
        <circle cx="150" cy="197" r="5" fill="var(--peach)" />
        <path d="M144 222h12v20h-12Z" fill="url(#cs-checks)" />
        <path class="cs-skirt" d="M144 240h12l20 46h-52Z" fill="url(#cs-checks)" stroke="var(--peach-soft)" stroke-width="1.5" />
      </g>

      <!-- Cámara grabando -->
      <g transform="translate(0 8)">
      <g class="cs-camera">
        <path d="M242 352l-16 42M242 352l16 42M242 352v42" stroke="var(--peach)" stroke-width="3" />
        <rect x="220" y="324" width="44" height="28" rx="3" fill="var(--peach)" />
        <path d="M220 330l-16-7v28l16-7Z" fill="var(--peach)" />
        <circle cx="232" cy="318" r="7" stroke="var(--peach)" stroke-width="3" />
        <circle cx="250" cy="318" r="7" stroke="var(--peach)" stroke-width="3" />
        <circle class="cs-rec" cx="256" cy="331" r="3" fill="var(--cobalt)" />
        <text class="cs-rec-label" x="228" y="346">REC</text>
      </g>
      </g>

      <!-- La grada: en la silla vacía aparece ella de niña -->
      {seats.map((seat) => (
        <>
          <path d={`M${seat.x - 11} ${seat.y + 16}v-18q0-6 6-6h10q6 0 6 6v18`} stroke="var(--peach)" stroke-width="2.5" />
          {!seat.kid && <circle cx={seat.x} cy={seat.y - 12} r="6" stroke="var(--peach)" stroke-width="2" />}
        </>
      ))}
      <g class="cs-kid">
        <circle cx="44" cy="346" r="6" fill="var(--peach)" />
        <circle cx="44" cy="338" r="3" fill="var(--peach)" />
        <path d="M38 366q0-12 6-12t6 12Z" fill="var(--peach)" />
        <path class="cs-wave" d="M49 356l8-12" stroke="var(--peach)" stroke-width="3" />
      </g>
    </>)}
    {kind === 'dentist' && (<>
      <!-- Fluorescente del techo -->
      <path d="M118 98v32M182 98v32" stroke="var(--peach)" stroke-width="1.5" opacity="0.6" />
      <rect class="cd-tube" x="104" y="130" width="92" height="9" rx="4.5" fill="var(--peach-soft)" />
      {shards.map((shard) => (
        <path class="cd-shard" style={`--r:${shard.r}deg;--d:${shard.d}s`} d={`M${shard.x} 136l7 2-4 6Z`} fill="var(--peach-soft)" />
      ))}

      <!-- Suelo, mesa y bote de caramelos -->
      <path d="M24 340h252" stroke="var(--peach)" stroke-width="2" opacity="0.5" />
      <path d="M232 238h46M262 238v102" stroke="var(--peach)" stroke-width="4" />
      <g class="cd-jar">
        <rect x="240" y="204" width="26" height="32" rx="4" stroke="var(--peach)" stroke-width="2.5" />
        <path d="M238 204h30" stroke="var(--peach)" stroke-width="4" />
        <circle cx="248" cy="228" r="3.5" fill="var(--peach)" /><circle cx="258" cy="226" r="3.5" fill="var(--peach)" /><circle cx="253" cy="219" r="3.5" fill="var(--peach)" />
      </g>
      <g class="cd-candy">
        <circle cx="253" cy="222" r="5" fill="var(--peach-soft)" />
        <path d="M248 222l-5-4v8ZM258 222l5-4v8Z" fill="var(--peach-soft)" />
      </g>

      <!-- El sillón -->
      <path d="M150 276v44M114 324h72" stroke="var(--peach)" stroke-width="6" />
      <path d="M66 262l150 10" stroke="var(--peach)" stroke-width="7" />
      <path d="M62 252l-8-34" stroke="var(--peach)" stroke-width="7" />

      <!-- Diego: babero, pantalones de campana y aliento -->
      <path d="M100 250l90 10" stroke="var(--peach)" stroke-width="15" />
      <path d="M114 242l22 2-6 16-14-2Z" fill="var(--cobalt)" stroke="var(--peach-soft)" stroke-width="1.5" />
      <path d="M190 260l26 4 14 30M196 264l24 2 6 30" stroke="var(--peach)" stroke-width="7" />
      <path d="M220 290l20 0-4 12h-26Z" fill="var(--peach)" />
      <circle cx="84" cy="240" r="13" fill="var(--peach)" />
      <path d="M78 236h3M88 236h3" stroke="var(--cobalt)" stroke-width="2" />
      <circle cx="86" cy="246" r="2.5" fill="var(--cobalt)" />
      {[0, 1, 2].map((i) => (
        <path class="cd-stink" style={`--s:${i * 0.6}s`} d={`M${80 + i * 10} 222q-5-6 0-12t0-12`} stroke="var(--peach-soft)" stroke-width="2" />
      ))}

      <!-- El grifo extensible, girando como un lazo -->
      <path d="M112 246l8-40" stroke="var(--peach)" stroke-width="5" />
      <g class="cd-lasso">
        <path d="M120 206q30-46 50-60" stroke="var(--peach-soft)" stroke-width="3" />
        <rect x="166" y="140" width="10" height="8" rx="2" fill="var(--peach)" />
      </g>

      <!-- La fuente -->
      <g class="cd-fountain">
        <rect x="32" y="332" width="12" height="8" rx="2" fill="var(--peach)" />
        {drops.map((drop) => (
          <circle class="cd-drop" style={`--dx:${drop.dx}px;--h:${-drop.h}px;--d:${drop.d}s`} cx="38" cy="330" r="3" fill="var(--peach-soft)" />
        ))}
      </g>
    </>)}

    {kind === 'tube' && (<>
      <!-- Mueble y suelo -->
      <path d="M84 290v50M216 290v50M70 290h160" stroke="var(--peach)" stroke-width="4" />
      <path d="M30 342h240" stroke="var(--peach)" stroke-width="2" opacity="0.5" />

      <g class="ct-tv">
        <g class="ct-antenna">
          <path d="M150 130l-42-46M150 130l40-42" stroke="var(--peach)" stroke-width="3" />
          <circle cx="108" cy="84" r="4" fill="var(--peach)" /><circle cx="190" cy="88" r="4" fill="var(--peach)" />
        </g>
        <rect x="60" y="128" width="180" height="162" rx="16" fill="var(--peach)" />
        <rect x="76" y="144" width="122" height="130" rx="22" fill="var(--cobalt)" />
        <circle cx="219" cy="168" r="9" stroke="var(--cobalt)" stroke-width="3" />
        <circle cx="219" cy="198" r="9" stroke="var(--cobalt)" stroke-width="3" />
        <path d="M209 230h20M209 240h20M209 250h20" stroke="var(--cobalt)" stroke-width="2.5" />

        <!-- Pantalla: el concurso -->
        <g class="ct-letters">
          {tiles.map((tile) => (
            <g class="ct-tile" style={`--t:${tile.i * 0.08}s`}>
              <rect x={tile.x} y={tile.y} width="15" height="20" rx="2" fill="var(--peach-soft)" />
              <text class="ct-letter" x={tile.x + 7.5} y={tile.y + 15} text-anchor="middle">{tile.letter}</text>
            </g>
          ))}
          <rect class="ct-timer" x="90" y="238" width="94" height="6" rx="3" fill="var(--peach)" />
        </g>

        <!-- Pantalla: Yolanda dentro, mareada -->
        <g class="ct-face">
          <path d="M100 176q10-12 22-4q12-10 24-2q12-8 22 4" stroke="var(--peach)" stroke-width="3" />
          <path class="ct-eye" d="M118 206m-8 0a8 8 0 1 0 16 0a5 5 0 1 0-10 0a2 2 0 1 0 4 0" stroke="var(--peach)" stroke-width="2" />
          <path class="ct-eye" d="M156 206m-8 0a8 8 0 1 0 16 0a5 5 0 1 0-10 0a2 2 0 1 0 4 0" stroke="var(--peach)" stroke-width="2" />
          <path d="M120 240q8-6 16 0t16 0" stroke="var(--peach)" stroke-width="3" />
        </g>
        <rect class="ct-static" x="76" y="144" width="122" height="130" rx="22" fill="var(--peach-soft)" />
        <path class="ct-crack" d={cracks} stroke="var(--peach-soft)" stroke-width="2" />
      </g>

      <!-- El tubo de la aspiradora -->
      <g class="ct-vacuum">
        <path d="M312 70L188 176" stroke="var(--peach)" stroke-width="9" />
        <path d="M312 70L188 176" stroke="var(--cobalt)" stroke-width="9" stroke-dasharray="2 10" />
        <path d="M176 168l18 22 10-8-18-22Z" fill="var(--peach)" />
      </g>
    </>)}
  </svg>
</div>

<script>
  // Las portadas animadas solo se mueven mientras están a la vista.
  function initCoverArt() {
    const covers = document.querySelectorAll<HTMLElement>('[data-cover-art]');
    if (!covers.length || !('IntersectionObserver' in window)) return;
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) entry.target.toggleAttribute('data-playing', entry.isIntersecting);
    });
    covers.forEach((cover) => observer.observe(cover));
    document.addEventListener('astro:before-swap', () => observer.disconnect(), { once: true });
  }

  document.addEventListener('astro:page-load', initCoverArt);
</script>

<style>
  .cv {
    display: block;
    background: var(--cobalt);
  }

  .cv svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .cv-title text {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 19px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    fill: var(--peach);
  }

  .cv-title .cv-sub {
    font-family: var(--font-script);
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .cv-cake-text {
    font-family: var(--font-script);
    font-weight: 700;
    font-size: 10px;
    letter-spacing: 0.08em;
    fill: var(--cobalt);
  }

  .cv-gasp {
    font-family: var(--font-display);
    font-size: 20px;
    fill: var(--peach);
    opacity: 0;
  }

  .cv :global(*) {
    transform-box: fill-box;
    transform-origin: center;
  }

  /* Los brazos giran desde el hombro, en coordenadas del dibujo. */
  .cv .cv-arm {
    transform-box: view-box;
  }

  .cv .cv-arm--l {
    transform-origin: 124px 248px;
  }

  .cv .cv-arm--r {
    transform-origin: 176px 248px;
  }

  .cv-flame {
    transform-origin: center bottom;
  }

  .cv-sister {
    transform-origin: center bottom;
  }

  .cs-sign {
    font-family: var(--font-script);
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.08em;
    fill: var(--peach);
  }

  .cs-rec-label {
    font-family: var(--font-script);
    font-weight: 700;
    font-size: 7px;
    fill: var(--cobalt);
  }

  /* Focos: giran desde la lámpara. */
  .cv .cs-spot {
    transform-box: view-box;
  }

  .cv .cs-spot--l {
    transform-origin: 46px 122px;
  }

  .cv .cs-spot--r {
    transform-origin: 254px 122px;
  }

  .cv .cs-dancer,
  .cv .cs-skirt {
    transform-origin: center bottom;
  }

  .cv .cs-arm--l {
    transform-origin: right bottom;
  }

  .cv .cs-arm--r {
    transform-origin: left bottom;
  }

  .cv .cs-wave {
    transform-origin: left bottom;
  }

  .cv .cs-camera {
    transform-origin: center bottom;
  }

  .ct-letter {
    font-family: var(--font-script);
    font-weight: 700;
    font-size: 13px;
    fill: var(--cobalt);
  }

  /* Sin movimiento: el final, con ella dentro de la tele. */
  .ct-letters,
  .ct-static {
    opacity: 0;
  }

  .cv .ct-vacuum {
    transform-box: view-box;
    transform-origin: 312px 70px;
    rotate: -24deg;
  }

  .cv .ct-antenna {
    transform-origin: center bottom;
