---
import Motif from './Motif.astro';

/** Banda con una frase destacada (manifiesto o cierre), entre destellos. */
interface Props {
  text: string;
  tone?: 'cobalt' | 'peach';
  size?: 'lg' | 'md';
  /** Los destellos se encienden y la frase entra con un corte al llegar a pantalla (ver RevealOnScroll). */
  reveal?: boolean;
}

const { text, tone = 'cobalt', size = 'lg', reveal = false } = Astro.props;
// Con reveal, la frase se lee palabra a palabra al ritmo del scroll.
const words = text.split(/\s+/);
---

<section class:list={['quote', `quote--${size}`, { 'quote--reveal': reveal }]} data-tone={tone}>
  <div class="container quote__inner" data-reveal={reveal ? '' : undefined}>
    <Motif kind="sparkle" size={reveal ? '2.75rem' : '1.75rem'} class="quote__spark quote__spark--a" />
    <blockquote class="quote__text">
      {reveal ? (
        <p aria-label={text}>
          {words.map((word, i) => (
            <><span class="quote__word" aria-hidden="true" style={`--w:${i};--n:${words.length}`}>{word}</span>{' '}</>
          ))}
        </p>
      ) : (
        <p>{text}</p>
      )}
    </blockquote>
    <Motif kind="sparkle" size={reveal ? '1.5rem' : '1.1rem'} class="quote__spark quote__spark--b" />
  </div>
</section>

<style>
  .quote {
    padding-block: clamp(3.5rem, 2.5rem + 5vw, 7rem);
  }

  .quote--md {
    padding-block: var(--space-12);
  }

  .quote__inner {
    position: relative;
    display: grid;
    justify-items: center;
    gap: var(--space-6);
    text-align: center;
  }

  .quote__text {
    margin: 0;
  }

  .quote__text p {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 300;
    font-style: italic;
    font-size: var(--text-2xl);
    line-height: 1.3;
    color: var(--heading);
    max-width: 30ch;
  }

  .quote--md .quote__text p {
    max-width: 44ch;
  }

  .quote--md .quote__text p {
    font-size: var(--text-xl);
  }

  .quote__inner :global(.quote__spark) {
    color: var(--accent);
  }

  .quote__inner :global(.quote__spark--b) {
    opacity: 0.8;
  }

  .quote--reveal {
    padding-block: clamp(4.5rem, 3rem + 7vw, 9rem);
  }

  .quote--reveal .quote__text p {
    max-width: 30ch;
    font-size: var(--text-2xl);
    line-height: 1.25;
  }

  .quote__word {
    display: inline-block;
  }

  /*
   * La banda cobalto se abre como un telón al entrar (de franja a ancho completo),
   * y la frase se lee: cada palabra pasa de apagada a encendida según avanza el scroll.
   * Sin scroll-driven animations: los destellos se encienden y las palabras llegan en cascada.
   */
  @media (prefers-reduced-motion: no-preference) {
    .quote__inner[data-reveal='pending'] :global(.quote__spark) {
      scale: 0;
    }

    .quote__inner[data-reveal='in'] :global(.quote__spark--a) {
      animation: spark-on 1100ms var(--ease-out) backwards;
    }

    .quote__inner[data-reveal='in'] :global(.quote__spark--b) {
      animation: spark-on 1100ms var(--ease-out) 700ms backwards;
    }

    .quote__inner :global(.quote__spark--a) {
      transition: rotate 900ms var(--ease-out);
    }

    .quote:hover :global(.quote__spark--a) {
      rotate: 90deg;
    }

    .quote__inner[data-reveal='pending'] .quote__word {
      opacity: 0;
    }

    .quote__inner[data-reveal='in'] .quote__word {
      animation: word-in 700ms var(--ease-out) calc(200ms + min(var(--w), 24) * 55ms) backwards;
    }

    @supports (animation-timeline: view()) {
      .quote--reveal {
        view-timeline: --quote block;
        animation-name: curtain;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --quote;
        animation-range: entry 0% entry 90%;
      }

      .quote--reveal .quote__inner[data-reveal] .quote__word {
        opacity: 1;
        animation-name: word-lit;
        animation-duration: auto;
        animation-delay: 0s;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --quote;
        animation-range: cover calc(14% + var(--w) / var(--n) * 22%) cover calc(20% + var(--w) / var(--n) * 22%);
      }
    }
  }

  @keyframes curtain {
    from {
      clip-path: inset(0 clamp(1rem, 12vw, 12rem));
    }
    to {
      clip-path: inset(0 0);
    }
  }

  @keyframes word-in {
    from {
      opacity: 0;
      translate: 0 0.35em;
      filter: blur(6px);
    }
    to {
      opacity: 1;
      translate: 0 0;
      filter: blur(0);
    }
  }

  @keyframes word-lit {
    from {
      opacity: 0.22;
      translate: 0 0.12em;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  @keyframes spark-on {
    from {
      scale: 0;
      rotate: -180deg;
    }
    to {
      scale: 1;
      rotate: 0deg;
    }
  }
</style>
