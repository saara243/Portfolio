---
import Motif from './Motif.astro';
import SocialLinks from './SocialLinks.astro';
import type { Profile } from '../modules/profile/domain/Profile';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  profile: Profile;
}

const { lang, profile } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="footer" data-tone="peach">
  <div class="container footer__inner">
    <Motif kind="sparkle" size="1.5rem" class="footer__spark" />
    <p class="footer__name">{profile.getName()}</p>
    <SocialLinks links={profile.getSocials()} email={profile.getEmail()} />
    {profile.getLocation() && <p class="footer__location">{profile.getLocation()}</p>}
    <p class="footer__fade script-font" aria-hidden="true">{t('404.title')}</p>
    <p class="footer__legal">
      © {year} {profile.getName()}. {t('footer.rights')}
      <small>{t('footer.ip')}</small>
    </p>
  </div>
</footer>

<style>
  .footer {
    padding-block: var(--band-pad) var(--space-12);
    border-top: 1px solid var(--line);
  }

  .footer__inner {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    text-align: center;
  }

  .footer__inner :global(.footer__spark) {
    color: var(--cobalt);
  }

  .footer__name {
    margin: 0 0 var(--space-4);
    font-family: var(--font-display);
    font-weight: 300;
    font-size: var(--text-3xl);
    line-height: 1;
    letter-spacing: 0.02em;
    color: var(--cobalt);
  }

  .footer__location {
    margin: 0;
    color: var(--cobalt);
  }

  .footer__fade {
    margin: var(--space-12) 0 0;
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--cobalt);
  }

  .footer__legal {
    display: grid;
    gap: var(--space-2);
    max-width: 60ch;
    margin: 0;
    font-size: var(--text-xs);
    color: var(--muted);
  }
</style>
