---
import type { Motivation } from '../modules/profile/domain/Motivation';

/** Carta de motivación: título grande en cobalto + hoja melocotón con los párrafos. */
interface Props {
  motivation: Motivation;
  scene: string;
  /** Acreditación de equipo que cuelga junto al título: «empezar a trabajar en un plató». */
  pass?: { label: string; name: string; role: string };
  /** Slugline tecleada y título con corte al llegar a pantalla (ver RevealOnScroll). */
  reveal?: boolean;
}

const { motivation, scene, pass, reveal = false } = Astro.props;
// Código de barras decorativo, siempre igual para el mismo nombre.
const bars = pass
  ? Array.from(pass.name.toUpperCase() + pass.role).slice(0, 22).map((char, i) => ({ x: i * 4.4, w: (char.charCodeAt(0) % 3) + 1 }))
  : [];
---

<section class="band letter" data-tone="cobalt">
  <div class="container letter__inner">
    <div class="letter__head" data-reveal={reveal ? '' : undefined}>
      <p class:list={['letter__slug script-font', { 'reveal-type': reveal }]} style={reveal ? `--chars:${scene.length}` : undefined}>{scene}</p>
      <h2 class:list={['letter__title', { 'reveal-line': reveal }]}>{motivation.getTitle()}</h2>
      {pass && (
        <div class="pass" data-pass aria-hidden="true">
          <div class="pass__swing">
            <svg class="pass__strap" viewBox="0 0 40 40" preserveAspectRatio="none">
              <path d="M2 0 18 40M38 0 22 40" stroke="currentColor" stroke-width="2.5" vector-effect="non-scaling-stroke" />
            </svg>
            <span class="pass__clip"></span>
            <div class="pass__card" data-tone="peach">
              <span class="pass__slot"></span>
              <p class="pass__label script-font">{pass.label}</p>
              <svg class="pass__photo" viewBox="0 0 40 48" fill="none" stroke="currentColor" stroke-width="1.6">
                <rect x="1" y="1" width="38" height="46" fill="currentColor" fill-opacity="0.1" />
                <circle cx="20" cy="19" r="8" />
                <path d="M6 47c1-10 7-14 14-14s13 4 14 14" />
              </svg>
              <p class="pass__name">{pass.name}</p>
              <p class="pass__role">{pass.role}</p>
              <svg class="pass__barcode" viewBox="0 0 97 12" preserveAspectRatio="none">
                {bars.map(({ x, w }) => <rect x={x} y="0" width={w} height="12" fill="currentColor" />)}
              </svg>
            </div>
          </div>
        </div>
      )}
    </div>

    <div class="letter__sheet" data-tone="peach" data-reveal={reveal ? '' : undefined}>
      {motivation.getParagraphs().map((paragraph, i) => <p style={`--p:${i}`}>{paragraph}</p>)}
      <slot />
    </div>
  </div>

  {motivation.getClosing() && (
    <div class="container">
      <p class="letter__closing" data-reveal={reveal ? '' : undefined}>{motivation.getClosing()}</p>
    </div>
  )}
</section>

<style>
  .letter__inner {
    display: grid;
    gap: var(--space-12);
  }

  .letter__slug {
    margin: 0 0 var(--space-3);
    font-weight: 700;
    font-size: var(--text-sm);
    text-transform: uppercase;
  }

  .letter__title {
    margin: 0 0 var(--space-8);
    font-size: var(--text-3xl);
  }

  /*
   * Acreditación colgada de su cinta. Al entrar en pantalla cae y se balancea como un péndulo
   * hasta casi pararse; luego se mece suave (pausado fuera de pantalla). Al pasar el ratón,
   * se balancea con más fuerza.
   */
  .pass {
    --amp: 2.5;
    width: clamp(8.5rem, 6rem + 6vw, 12.5rem);
    margin-top: calc(-1 * var(--space-4));
  }

  .pass__swing {
    display: grid;
    justify-items: center;
    transform-origin: 50% 0;
  }

  /* Cinta en V que sube fuera del encuadre. */
  .pass__strap {
    width: 46%;
    height: clamp(2.5rem, 2rem + 2vw, 4rem);
    color: var(--peach);
    overflow: visible;
  }

  .pass__clip {
    width: 16%;
    aspect-ratio: 1.6;
    margin-top: -1px;
    border: 2px solid var(--peach);
    border-bottom-width: 4px;
  }

  .pass__card {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.35rem;
    width: 100%;
    margin-top: -2px;
    padding: 1.4rem 0.9rem 0.9rem;
    color: var(--cobalt);
    text-align: center;
  }

  .pass__slot {
    position: absolute;
    top: 0.55rem;
    left: 50%;
    width: 26%;
    height: 0.35rem;
    translate: -50% 0;
    background: var(--cobalt);
    opacity: 0.85;
  }

  .pass__card p {
    margin: 0;
  }

  .pass__label {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .pass__photo {
    width: 46%;
    margin-block: 0.2rem;
  }

  .pass__name {
    font-family: var(--font-display);
    font-size: clamp(0.85rem, 0.7rem + 0.5vw, 1.1rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
  }

  .pass__role {
    font-size: 0.7rem;
    line-height: 1.2;
    color: var(--ink);
  }

  .pass__barcode {
    width: 80%;
    height: 0.85rem;
    margin-top: 0.3rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .pass__swing {
      animation: pass-sway 4.8s ease-in-out infinite;
    }

    .pass:not([data-playing]) .pass__swing {
      animation-play-state: paused;
    }

    .letter__head[data-reveal='pending'] .pass__swing {
      opacity: 0;
    }

    .letter__head[data-reveal='in'] .pass__swing {
      animation:
        pass-drop 2200ms cubic-bezier(0.2, 0.7, 0.3, 1) 300ms backwards,
        pass-sway 4.8s ease-in-out 2500ms infinite;
    }

    @media (hover: hover) {
      .pass:hover {
        --amp: 7;
      }
    }
  }

  @keyframes pass-drop {
    0% { opacity: 0; translate: 0 -35%; rotate: 0deg; }
    18% { opacity: 1; translate: 0 0; rotate: 0deg; }
    34% { rotate: 13deg; }
    50% { rotate: -9deg; }
    64% { rotate: 6deg; }
    77% { rotate: -3.5deg; }
    89% { rotate: 1.5deg; }
    100% { rotate: calc(var(--amp) * -1deg); }
  }

  @keyframes pass-sway {
    0%, 100% { rotate: calc(var(--amp) * -1deg); }
    50% { rotate: calc(var(--amp) * 1deg); }
  }

  /*
   * La hoja sale de la máquina: se desenrolla de arriba abajo mientras sube,
   * y los párrafos se asientan en cascada detrás del borde que baja.
   * El cierre se enfoca como un último plano.
   */
  @media (prefers-reduced-motion: no-preference) {
    .letter__sheet[data-reveal='pending'] {
      clip-path: inset(0 0 100% 0);
    }

    .letter__sheet[data-reveal='pending'] > :global(*),
    .letter__closing[data-reveal='pending'] {
      opacity: 0;
    }

    .letter__sheet[data-reveal='in'] {
      animation: sheet-unroll 1300ms var(--ease-out) backwards;
    }

    .letter__sheet[data-reveal='in'] > :global(*) {
      animation: settle 800ms var(--ease-out) calc(300ms + min(var(--p, 4), 5) * 120ms) backwards;
    }

    .letter__closing[data-reveal='in'] {
      animation: closing-focus 1400ms var(--ease-out) 150ms backwards;
    }
  }

  @keyframes sheet-unroll {
    from {
      clip-path: inset(0 0 100% 0);
      translate: 0 3rem;
    }
    to {
      clip-path: inset(0 0 0 0);
      translate: 0 0;
    }
  }

  @keyframes closing-focus {
    from {
      opacity: 0;
      filter: blur(12px);
      letter-spacing: 0.08em;
    }
    to {
      opacity: 1;
      filter: blur(0);
      letter-spacing: normal;
    }
  }

  .letter__sheet {
    padding: clamp(1.75rem, 1rem + 3vw, 3.5rem);
    font-size: var(--text-base);
  }

  .letter__sheet p {
    max-width: 60ch;
  }

  .letter__sheet p:last-of-type {
    margin-bottom: 0;
  }

  .letter__closing {
    max-width: 44ch;
    margin: var(--space-16) auto 0;
    font-family: var(--font-display);
    font-weight: 300;
    font-style: italic;
    font-size: var(--text-xl);
    line-height: 1.4;
    text-align: center;
  }

  @media (min-width: 900px) {
    .letter__inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: start;
      gap: var(--space-16);
    }

    .letter__head {
      position: sticky;
      top: 7rem;
    }
  }
</style>

<script>
  // La acreditación solo se mece mientras está a la vista.
  function initPass() {
    const pass = document.querySelector<HTMLElement>('[data-pass]');
    if (!pass || !('IntersectionObserver' in window)) return;
    const observer = new IntersectionObserver(([entry]) => pass.toggleAttribute('data-playing', entry.isIntersecting));
    observer.observe(pass);
    document.addEventListener('astro:before-swap', () => observer.disconnect(), { once: true });
  }

  document.addEventListener('astro:page-load', initPass);
</script>
