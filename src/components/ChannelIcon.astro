---
/**
 * Viñeta animada de un canal de contacto, en baldosa del color de acento de la banda:
 * - mail: una carta asoma del sobre y vuelve a guardarse.
 * - instagram: la cámara enfoca (el objetivo se ajusta) y salta el flash.
 * - link: cualquier otra red; una flecha que sale de la caja.
 * Solo se anima con [data-playing] (IntersectionObserver de la página); sin movimiento, quieta.
 */
interface Props {
  kind: 'mail' | 'instagram' | 'link';
}

const { kind } = Astro.props;
---

<span class:list={['ch', `ch--${kind}`]} data-channel-icon aria-hidden="true">
  <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    {kind === 'mail' && (
      <>
        <g class="ch-letter">
          <rect x="13" y="12" width="22" height="20" fill="var(--accent)" />
          <path d="M17 18h14M17 22h10M17 26h12" stroke-width="1.5" />
        </g>
        <path d="M7 20h34v20H7Z" fill="var(--accent)" />
        <path d="M7 20l17 12 17-12" />
        <path class="ch-flap" d="M7 20l17-10 17 10" />
      </>
    )}

    {kind === 'instagram' && (
      <>
        <rect x="8" y="8" width="32" height="32" rx="9" />
        <circle class="ch-lens" cx="24" cy="24" r="7.5" />
        <circle class="ch-dot" cx="33" cy="15" r="1.6" fill="currentColor" stroke="none" />
        <circle class="ch-flash" cx="24" cy="24" r="16" fill="currentColor" stroke="none" />
      </>
    )}

    {kind === 'link' && (
      <>
        <path d="M30 10h8v8M38 10 22 26" class="ch-arrow" />
        <path d="M34 28v8a2 2 0 0 1-2 2H12a2 2 0 0 1-2-2V16a2 2 0 0 1 2-2h8" />
      </>
    )}
  </svg>
</span>

<style>
  .ch {
    display: grid;
    place-items: center;
    flex: none;
    width: clamp(3rem, 2.4rem + 1.6vw, 3.75rem);
    aspect-ratio: 1;
    background: var(--accent);
    color: var(--on-accent);
  }

  .ch svg {
    width: 76%;
    height: 76%;
    overflow: visible;
  }

  .ch :global(*) {
    transform-box: fill-box;
    transform-origin: center;
  }

  .ch-flash {
    opacity: 0;
  }

  .ch:not([data-playing]) :global(*) {
    animation-play-state: paused !important;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Mail: la carta asoma y vuelve a entrar; la solapa se levanta para dejarla salir. */
    .ch-letter {
      animation: ch-letter 3.2s var(--ease-out) infinite;
    }

    .ch-flap {
      transform-origin: center bottom;
      animation: ch-flap 3.2s var(--ease-out) infinite;
    }

    /* Instagram: el objetivo enfoca, el piloto parpadea y salta el flash. */
    .ch-lens {
      animation: ch-focus 3.2s var(--ease-out) infinite;
    }

    .ch-dot {
      animation: ch-blink 3.2s steps(1, end) infinite;
    }

    .ch-flash {
      animation: ch-flash 3.2s ease-out infinite;
    }

    /* Otras redes: la flecha sale de la caja. */
    .ch-arrow {
      animation: ch-arrow 2.4s var(--ease-out) infinite;
    }
  }

  @keyframes ch-letter {
    0%, 15% { translate: 0 10px; }
    40%, 70% { translate: 0 -5px; }
    95%, 100% { translate: 0 10px; }
  }

  @keyframes ch-flap {
    0%, 12% { scale: 1 1; }
    25%, 72% { scale: 1 -1; }
    88%, 100% { scale: 1 1; }
  }

  @keyframes ch-focus {
    0%, 20% { scale: 1; }
    35% { scale: 0.7; }
    50% { scale: 1.12; }
    60%, 100% { scale: 1; }
  }

  @keyframes ch-blink {
    0%, 60% { opacity: 1; }
    62% { opacity: 0; }
    66%, 100% { opacity: 1; }
  }

  @keyframes ch-flash {
    0%, 60% { opacity: 0; scale: 0.4; }
    62% { opacity: 0.85; scale: 1; }
    80%, 100% { opacity: 0; scale: 1.3; }
  }

  @keyframes ch-arrow {
    0%, 20% { translate: 0 0; }
    50% { translate: 3px -3px; }
    80%, 100% { translate: 0 0; }
  }
</style>
