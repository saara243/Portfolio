---
/** Encabezado de sección: slugline de guion en Courier (INT. LUGAR — DÍA) + título. */
interface Props {
  scene: string;
  title?: string;
  level?: 1 | 2;
  align?: 'start' | 'center';
  size?: 'md' | 'lg';
}

const { scene, title, level = 2, align = 'start', size = 'md' } = Astro.props;
const Heading = level === 1 ? 'h1' : 'h2';
---

<div class:list={['scene', `scene--${align}`, `scene--${size}`]}>
  <p class="scene__slug script-font">{scene}</p>
  {title && <Heading class="scene__title">{title}</Heading>}
</div>

<style>
  .scene {
    margin-bottom: var(--space-12);
  }

  .scene--center {
    text-align: center;
  }

  .scene__slug {
    margin: 0 0 var(--space-3);
    font-weight: 700;
    font-size: var(--text-sm);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .scene__title {
    margin: 0;
    font-size: var(--text-2xl);
  }

  .scene--lg .scene__title {
    font-size: var(--text-3xl);
  }
</style>
