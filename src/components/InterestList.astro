---
import Motif from './Motif.astro';
import type { Interest } from '../modules/profile/domain/Interest';

/**
 * Temas que la autora quiere contar: palabra grande + descripción, en filas con filete.
 * En reposo solo se ve la palabra; al pasar (o enfocar con el teclado) la fila se vuelve cobalto
 * y entra la descripción. En pantallas táctiles, tocar la palabra despliega o recoge su texto.
 * Sin JavaScript se ven todas las descripciones (el plegado solo existe con .interests--folded).
 */
interface Props {
  interests: Interest[];
  /** Cada fila se escribe al llegar a pantalla: filete, asterisco, palabra y texto (ver RevealOnScroll). */
  reveal?: boolean;
}

const { interests, reveal = false } = Astro.props;
---

{interests.length > 0 && (
  <ul class="interests">
    <script is:inline>document.currentScript.parentElement.classList.add('interests--folded');</script>
    {interests.map((interest, i) => (
      <li class="interests__item" data-interest data-reveal={reveal ? '' : undefined} style={`--row:${i % 3}`}>
        <h3 class:list={['interests__title', { 'reveal-line': reveal }]}>
          <button class="interests__toggle" type="button" aria-expanded="false" aria-controls={`interest-${i}`} data-interest-toggle>
            <Motif kind="asterisk" size="0.7em" class="interests__mark" />
            {interest.getTitle()}
          </button>
        </h3>
        <div class="interests__reveal" id={`interest-${i}`}>
          <p class="interests__text">{interest.getDescription()}</p>
        </div>
      </li>
    ))}
  </ul>
)}

<script>
  // En táctil o con teclado, tocar (o pulsar Enter en) la palabra fija su texto; volver a tocar lo recoge.
  function initInterests() {
    document.querySelectorAll<HTMLButtonElement>('[data-interest-toggle]').forEach((toggle) => {
      if (toggle.dataset.ready) return;
      toggle.dataset.ready = 'true';
      const item = toggle.closest<HTMLElement>('[data-interest]');
      toggle.addEventListener('click', (event) => {
        // Con ratón manda el :hover; el clic solo fija el texto en táctil o con teclado.
        if (event instanceof PointerEvent && event.pointerType === 'mouse') return;
        const open = !item?.hasAttribute('data-open');
        item?.toggleAttribute('data-open', open);
        toggle.setAttribute('aria-expanded', String(open));
      });
    });
  }

  document.addEventListener('astro:page-load', initInterests);

</script>

<style>
  .interests {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .interests__item {
    position: relative;
    isolation: isolate;
    display: grid;
    gap: var(--space-3);
    padding-block: var(--space-8);
    border-bottom: 1px solid var(--line);
  }

  /* Hoja cobalto que barre la fila al pasar: la fila cambia de tono, como una banda. */
  .interests__item::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -1px calc(-1 * var(--gutter));
    background: var(--cobalt);
    clip-path: inset(0 100% 0 0);
    transition: clip-path 650ms var(--ease-out);
  }

  .interests__title {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin: 0;
    font-size: var(--text-2xl);
    line-height: 1;
    overflow-wrap: anywhere;
    transition: color 400ms var(--ease-out), translate 650ms var(--ease-out);
  }

  .interests__title :global(.interests__mark) {
    color: var(--cobalt);
    transition: rotate 900ms var(--ease-out), scale 900ms var(--ease-out), color 400ms var(--ease-out);
  }

  .interests__toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-4);
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    text-align: left;
    cursor: pointer;
  }

  .interests__toggle:focus-visible {
    outline-offset: 6px;
  }

  .interests__reveal {
    min-height: 0;
  }

  .interests__text {
    max-width: 52ch;
    margin: 0;
    font-size: var(--text-lg);
    font-weight: 300;
    line-height: 1.6;
    transition: color 400ms var(--ease-out);
  }

  @media (hover: hover) {
    .interests__item:hover::before {
      clip-path: inset(0 0 0 0);
    }

    .interests__item:hover .interests__title,
    .interests__item:hover .interests__text,
    .interests__item:hover :global(.interests__mark) {
      color: var(--peach);
    }

    .interests__item:hover :global(.interests__mark) {
      rotate: 180deg;
      scale: 1.25;
    }

    .interests__item:hover ::selection {
      background: var(--peach);
      color: var(--cobalt);
    }
  }

  @media (min-width: 900px) {
    .interests__item {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: center;
      gap: var(--space-12);
      padding-block: var(--space-8);
    }

  }

  /*
   * Plegado (solo con JS): en reposo, solo la palabra. Al pasar, enfocar o abrir, la descripción
   * entra desde la derecha. En una columna (móvil/tableta) la fila además crece para hacerle sitio;
   * en dos columnas el hueco ya está reservado y no hay saltos de maquetación.
   */
  .interests--folded .interests__text {
    opacity: 0;
    translate: 1.5rem 0;
    transition:
      opacity 250ms var(--ease-out),
      translate 250ms var(--ease-out),
      color 400ms var(--ease-out);
  }

  .interests--folded .interests__item:is([data-open], :has(.interests__toggle:focus-visible)) .interests__text {
    opacity: 1;
    translate: 0 0;
    transition:
      opacity 500ms var(--ease-out) 320ms,
      translate 600ms var(--ease-out) 320ms,
      color 400ms var(--ease-out);
  }

  /* Pasar por encima solo cuenta con ratón: en táctil el :hover se queda pegado tras tocar. */
  @media (hover: hover) {
    .interests--folded .interests__item:hover .interests__text {
      opacity: 1;
      translate: 0 0;
      transition:
        opacity 500ms var(--ease-out) 320ms,
        translate 600ms var(--ease-out) 320ms,
        color 400ms var(--ease-out);
    }
  }

  @media (max-width: 899px) {
    .interests--folded .interests__item {
      grid-template-rows: auto 0fr;
      row-gap: 0;
      transition: grid-template-rows 500ms var(--ease-out), row-gap 500ms var(--ease-out);
    }

    .interests--folded .interests__reveal {
      overflow: hidden;
    }

    .interests--folded .interests__item:is([data-open], :has(.interests__toggle:focus-visible)) {
      grid-template-rows: auto 1fr;
      row-gap: var(--space-3);
    }

    @media (hover: hover) {
      .interests--folded .interests__item:hover {
        grid-template-rows: auto 1fr;
        row-gap: var(--space-3);
      }
    }
  }

  /*
   * Palabra centrada en reposo; al abrir la fila se desliza a la izquierda y después entra el texto.
   */
  /*
   * Centrado sin JavaScript: cada fila es un contenedor de consulta, así que 50cqw es la mitad
   * de la fila y 50% la mitad de la palabra.
   */
  .interests--folded .interests__item {
    container-type: inline-size;
  }

  .interests--folded .interests__toggle {
    translate: calc(50cqw - 50%) 0;
    transition: translate 650ms var(--ease-out);
  }

  .interests--folded .interests__item:is([data-open], :has(.interests__toggle:focus-visible)) .interests__toggle {
    translate: 0 0;
  }

  @media (hover: hover) {
    .interests--folded .interests__item:hover .interests__toggle {
      translate: 0 0;
    }
  }

  /* La fila se vuelve cobalto también al enfocarla con el teclado o al dejarla abierta. */
  .interests__item:is([data-open], :has(.interests__toggle:focus-visible))::before {
    clip-path: inset(0 0 0 0);
  }

  .interests__item:is([data-open], :has(.interests__toggle:focus-visible)) :is(.interests__title, .interests__text) {
    color: var(--peach);
  }

  .interests__item:is([data-open], :has(.interests__toggle:focus-visible)) :global(.interests__mark) {
    color: var(--peach);
  }

  .interests__item:is([data-open], :has(.interests__toggle:focus-visible)) :global(.interests__mark) {
    rotate: 180deg;
    scale: 1.25;
  }

  @media (prefers-reduced-motion: reduce) {
    .interests--folded .interests__text,
    .interests--folded .interests__item,
    .interests--folded .interests__toggle {
      transition: none !important;
    }

    .interests--folded .interests__text {
      translate: none !important;
    }
  }

  /*
   * Revelado: el filete se traza de izquierda a derecha, el asterisco estalla rayo a rayo
   * desde el centro mientras gira hasta su sitio, la palabra sube con un corte y el texto se asienta.
   */
  @media (prefers-reduced-motion: no-preference) {
    .interests__item[data-reveal='pending'],
    .interests__item[data-reveal='in'] {
      --stagger: calc(var(--row) * 90ms);
      --line-delay: calc(var(--stagger) + 150ms);
      --fade-delay: calc(var(--stagger) + 420ms);
      border-bottom-color: transparent;
    }

    .interests__item[data-reveal='pending']::after,
    .interests__item[data-reveal='in']::after {
      content: '';
      position: absolute;
      inset: auto 0 -1px;
      height: 1px;
      background: var(--line);
      transform-origin: left;
    }

    .interests__item[data-reveal='pending']::after {
      scale: 0 1;
    }

    .interests__item[data-reveal='in']::after {
      animation: rule-draw 1200ms var(--ease-out) var(--stagger) backwards;
    }

    .interests__item[data-reveal='in'] :global(.interests__mark) {
      animation: mark-turn 1100ms var(--ease-out) var(--line-delay) backwards;
    }

    .interests__item[data-reveal='in'] :global(.motif__ray) {
      animation: ray-burst 700ms var(--ease-out) calc(var(--line-delay) + var(--i) * 35ms) backwards;
    }
  }

  @keyframes rule-draw {
    from {
      scale: 0 1;
    }
    to {
      scale: 1 1;
    }
  }

  @keyframes mark-turn {
    from {
      rotate: -180deg;
      scale: 0.3;
    }
    to {
      rotate: 0deg;
      scale: 1;
    }
  }

  @keyframes ray-burst {
    from {
      scale: 0;
    }
    to {
      scale: 1;
    }
  }
</style>
