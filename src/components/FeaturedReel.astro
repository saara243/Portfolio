---
import Motif from './Motif.astro';
import type { Script } from '../modules/scripts/domain/Script';
import type { UiKey } from '../i18n/ui';
import { localizedPath, routes, useTranslations, withBase, type Lang } from '../i18n/utils';

/**
 * Proyectos destacados de la home: cuadrícula de fotogramas 16:9 a sangre, separados por filetes.
 * Cada plano lleva siempre una etiqueta de papel (formato · año + título); al pasar o enfocar,
 * una hoja cobalto sube desde la etiqueta y descubre la logline. En pantallas táctiles la
 * ficha va fija debajo del plano.
 *
 * Imagen: `still` (fotograma horizontal) a sangre; si falta, la portada vertical entera sobre
 * un panel cobalto; si tampoco hay, el asterisco.
 */
interface Props {
  lang: Lang;
  scripts: Script[];
}

const { lang, scripts } = Astro.props;
const t = useTranslations(lang);
const columns = Math.min(scripts.length, 3);
---

<ul class="reel" data-reveal data-columns={columns}>
  {scripts.map((script, i) => {
    const still = script.getStill();
    const cover = script.getCover();
    const format = script.getFormat().getValue();
    const genres = script.getGenres().map((genre) => genre.getLabel()).join(' · ');
    return (
      <li class="reel__item" style={`--i:${Math.min(i, 5)}`}>
        <a class="reel__link" href={localizedPath(lang, routes.project(script.getSlug()))}>
          <div class:list={['reel__shot', still ? 'reel__shot--still' : cover ? 'reel__shot--poster' : 'reel__shot--empty']}>
            {still ? (
              <img class="reel__img" src={withBase(still)} alt="" width="1600" height="900" loading="lazy" decoding="async" />
            ) : cover ? (
              <img class="reel__poster" src={withBase(cover)} alt="" width="600" height="800" loading="lazy" decoding="async" />
            ) : (
              <Motif kind="asterisk" size="34%" class="reel__mark" />
            )}

            <span class="reel__sheet" aria-hidden="true"></span>

            <p class="reel__label">
              <span class="reel__meta script-font">{t(`format.${format}` as UiKey)} · {script.getDisplayDate()}</span>
              <span class="reel__title">{script.getTitle()}<span class="reel__arrow" aria-hidden="true">→</span></span>
            </p>
          </div>

          <div class="reel__detail" data-tone="cobalt">
            {genres && <p class="reel__genres">{genres}</p>}
            <p class="reel__logline">{script.getLogline()}</p>
            <span class="reel__more">{t('projects.read')} <span aria-hidden="true">→</span></span>
          </div>
        </a>
      </li>
    );
  })}
</ul>

<style>
  .reel {
    --gap: 2px;
    --label-pad: clamp(0.75rem, 0.5rem + 0.8vw, 1.25rem);
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--gap);
  }

  @media (min-width: 640px) {
    .reel:not([data-columns='1']) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    /* Número impar: el último plano ocupa la fila entera, en panorámico, en vez de quedar huérfano. */
    .reel:not([data-columns='1']) .reel__item:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1000px) {
    .reel[data-columns='3'] {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .reel[data-columns='3'] .reel__item:last-child:nth-child(odd) {
      grid-column: auto;
    }

    .reel[data-columns='3'] .reel__item:last-child:nth-child(3n + 1) {
      grid-column: 1 / -1;
    }
  }

  .reel__link {
    position: relative;
    display: block;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .reel__link:hover {
    color: inherit;
  }

  .reel__link:focus-visible {
    outline: 2px solid var(--peach);
    outline-offset: -6px;
  }

  .reel__shot {
    position: relative;
    isolation: isolate;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--cobalt);
  }

  /* Plano suelto a lo ancho: formato panorámico para no llenar la pantalla entera. */
  @media (min-width: 640px) {
    .reel__item:only-child .reel__shot,
    .reel:not([data-columns='1']) .reel__item:last-child:nth-child(odd) .reel__shot {
      aspect-ratio: 21 / 9;
    }
  }

  @media (min-width: 1000px) {
    .reel[data-columns='3'] .reel__item:last-child:nth-child(odd) .reel__shot {
      aspect-ratio: 16 / 9;
    }

    .reel[data-columns='3'] .reel__item:last-child:nth-child(3n + 1) .reel__shot {
      aspect-ratio: 21 / 9;
    }
  }

  .reel__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 1100ms var(--ease-out);
  }

  /* Cartel vertical sin fotograma: entero, a la derecha, sobre el panel cobalto. */
  .reel__poster {
    position: absolute;
    top: 9%;
    right: 7%;
    height: 82%;
    width: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    outline: 1px solid rgb(255 227 208 / 0.45);
    outline-offset: 6px;
    transition: scale 1100ms var(--ease-out), rotate 1100ms var(--ease-out);
  }

  .reel__shot :global(.reel__mark) {
    position: absolute;
    inset: 0;
    margin: auto;
    color: var(--peach);
    opacity: 0.6;
    transition: rotate 1400ms var(--ease-out), scale 1400ms var(--ease-out);
  }

  /* Hoja cobalto que sube desde la etiqueta al pasar. */
  .reel__sheet {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgb(2 98 222 / 0.92);
    clip-path: inset(100% 0 0 0);
    transition: clip-path 700ms var(--ease-out);
  }

  /* Etiqueta de papel: siempre visible y legible sobre cualquier imagen. */
  .reel__label {
    position: absolute;
    z-index: 2;
    left: 0;
    bottom: 0;
    max-width: calc(100% - 2rem);
    margin: 0;
    padding: var(--label-pad) calc(var(--label-pad) * 1.4) var(--label-pad) var(--label-pad);
    display: grid;
    gap: var(--space-1);
    background: var(--peach);
    color: var(--cobalt);
    transition: background-color 450ms var(--ease-out), color 450ms var(--ease-out);
  }

  .reel__meta {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .reel__title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: var(--text-xl);
    line-height: 1.1;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    text-wrap: balance;
  }

  .reel__arrow {
    display: none;
  }

  .reel__detail {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding: var(--label-pad) var(--label-pad) calc(var(--label-pad) * 1.5);
  }

  .reel__genres {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .reel__logline {
    margin: 0;
    max-width: 46ch;
    font-size: var(--text-base);
    font-weight: 300;
    line-height: 1.55;
  }

  .reel__more {
    justify-self: start;
    margin-top: var(--space-1);
    padding-bottom: var(--space-1);
    border-bottom: 1px solid var(--line);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  /*
   * Con ratón, la ficha flota sobre el plano y aparece al pasar o al enfocar con el teclado.
   * Sin ratón (táctil), se queda como bloque cobalto fijo debajo del plano.
   */
  @media (hover: hover) {
    .reel__detail {
      position: absolute;
      z-index: 3;
      inset: 0 0 auto 0;
      padding: calc(var(--label-pad) * 1.5) calc(var(--label-pad) * 1.5) 0;
      background: transparent;
      pointer-events: none;
      opacity: 0;
      translate: 0 0.75rem;
      transition: opacity 300ms var(--ease-out), translate 300ms var(--ease-out);
    }

    .reel__link:is(:hover, :focus-visible) .reel__sheet {
      clip-path: inset(0 0 0 0);
    }

    .reel__meta {
      transition: opacity 250ms var(--ease-out);
    }

    .reel__arrow {
      display: inline-block;
      margin-left: 0.4em;
      opacity: 0;
      translate: -0.5em 0;
      transition: opacity 400ms var(--ease-out), translate 600ms var(--ease-out);
    }

    .reel__more {
      display: none;
    }

    .reel__logline {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 3;
      overflow: hidden;
    }

    .reel__link:is(:hover, :focus-visible) .reel__label {
      background-color: transparent;
      color: var(--peach);
    }

    .reel__link:is(:hover, :focus-visible) .reel__meta {
      opacity: 0;
    }

    .reel__link:is(:hover, :focus-visible) .reel__arrow {
      opacity: 1;
      translate: 0 0;
      transition-delay: 200ms;
    }

    .reel__link:is(:hover, :focus-visible) .reel__detail {
      opacity: 1;
      translate: 0 0;
      transition-duration: 600ms;
      transition-delay: 200ms;
    }

    .reel__link:is(:hover, :focus-visible) .reel__img {
      scale: 1.06;
    }

    .reel__link:is(:hover, :focus-visible) .reel__poster {
      scale: 1.04;
      rotate: -1.5deg;
    }

    .reel__link:is(:hover, :focus-visible) :global(.reel__mark) {
      rotate: 90deg;
      scale: 1.15;
    }
  }

  /* Entrada: los planos se descubren de izquierda a derecha en cadena, como cortes de montaje. */
  @media (prefers-reduced-motion: no-preference) {
    .reel[data-reveal='pending'] .reel__shot {
      clip-path: inset(0 100% 0 0);
    }

    .reel[data-reveal='pending'] .reel__label {
      opacity: 0;
    }

    .reel[data-reveal='in'] .reel__shot {
      animation: shot-cut 1000ms var(--ease-out) calc(var(--i) * 120ms) backwards;
    }

    .reel[data-reveal='in'] .reel__img,
    .reel[data-reveal='in'] .reel__poster {
      animation: shot-settle 1500ms var(--ease-out) calc(var(--i) * 120ms) backwards;
    }

    .reel[data-reveal='in'] .reel__label {
      animation: label-stick 700ms var(--ease-out) calc(var(--i) * 120ms + 550ms) backwards;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reel__sheet,
    .reel__label,
    .reel__detail,
    .reel__img,
    .reel__poster {
      transition-duration: 1ms;
      transition-delay: 0ms;
    }
  }

  @keyframes shot-cut {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes shot-settle {
    from {
      scale: 1.15;
    }
    to {
      scale: 1;
    }
  }

  @keyframes label-stick {
    from {
      opacity: 0;
      translate: -0.75rem 0;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }
</style>
