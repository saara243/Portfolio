---
import BaseLayout from '../layouts/BaseLayout.astro';
import { DEFAULT_LOCALE, localizedPath, useTranslations } from '../i18n/utils';

// GitHub Pages sirve un único 404.html, así que se muestra en el idioma por defecto.
const lang = DEFAULT_LOCALE;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} path="" title="404">
  <section class="section container not-found">
    <p class="not-found__code script-font">404</p>
    <h1 class="not-found__title script-font">{t('404.title')}</h1>
    <p>{t('404.text')}</p>
    <a class="button button--primary" href={localizedPath(lang)}>{t('404.back')}</a>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    justify-items: center;
    text-align: center;
    padding-block: var(--space-24);
  }

  .not-found__code {
    color: var(--color-accent);
    letter-spacing: 0.3em;
  }

  .not-found__title {
    font-size: var(--text-hero);
    text-transform: uppercase;
  }
</style>
