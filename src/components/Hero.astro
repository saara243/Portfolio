---
import DownloadButton from './DownloadButton.astro';
import type { Profile } from '../modules/profile/domain/Profile';
import { localizedPath, routes, useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  profile: Profile;
}

const { lang, profile } = Astro.props;
const t = useTranslations(lang);
const cv = profile.getCv();
const slug = t('scene.home');
const name = profile.getName();
// El nombre entra letra a letra: cada palabra en su línea, índice global para el desfase.
let letterIndex = 0;
const nameLines = name.split(/\s+/).map((word) => Array.from(word).map((char) => ({ char, i: letterIndex++ })));

/*
 * Página de guion junto al nombre, montada solo con contenido real del perfil y en formato
 * profesional: transición, slugline, acción (lema y temas), personaje, acotación, diálogo
 * (frase-manifiesto) y transición de salida. Se teclea como a máquina: ritmo irregular pero
 * determinista, pausas tras la puntuación y una pausa larga al cambiar de bloque.
 * --t es el momento (ms) en que cae cada carácter y --d cuánto se queda el cursor detrás de él.
 */
type BlockKind = 'transition-in' | 'slug' | 'action' | 'character' | 'parenthetical' | 'dialogue' | 'transition';
const statement = profile.getStatement();
const themes = profile.getInterests().map((interest) => `${interest.getTitle()}.`).join(' ');
const rawBlocks: [BlockKind, string][] = [
  ['transition-in', t('scene.fadeIn')],
  ['slug', slug],
  // Si el lema coincide con la frase-manifiesto, no se repite: ya va como diálogo.
  ...(profile.getTagline() !== statement ? ([['action', profile.getTagline()]] as [BlockKind, string][]) : []),
  ...(themes ? ([['action', themes]] as [BlockKind, string][]) : []),
  ...(statement
    ? ([
        ['character', name.split(/\s+/)[0].toUpperCase()],
        ['parenthetical', t('scene.toCamera')],
        ['dialogue', statement],
      ] as [BlockKind, string][])
    : []),
  ['transition', t('scene.cut')],
];

const KEY = 8; // ms base por pulsación
const BLOCK_PAUSE = 200; // ms al cambiar de bloque (retorno de carro)
let clock = 0;
let seed = 0;
const strike = (char: string) => {
  seed = (seed * 9301 + 49297) % 233280;
  const jitter = (seed / 233280) * 7; // 0–7 ms de irregularidad
  const punct = /[.,:;!?]/.test(char) ? 60 : char === ' ' ? 6 : 0;
  return KEY + jitter + punct;
};
const pageBlocks = rawBlocks.map(([kind, text], b) => {
  const chars: { char: string; t: number; d: number }[] = [];
  const words = text.split(' ').map((word, w, all) => {
    const letters = Array.from(word).map((char) => {
      const entry = { char, t: Math.round(clock), d: 0 };
      chars.push(entry);
      clock += strike(char);
      return entry;
    });
    if (w < all.length - 1) clock += strike(' ');
    return letters;
  });
  const isLast = b === rawBlocks.length - 1;
  if (!isLast) clock += BLOCK_PAUSE;
  return { kind, words, chars };
});
// El cursor se queda tras cada carácter hasta que cae el siguiente.
const allChars = pageBlocks.flatMap((block) => block.chars);
allChars.forEach((entry, n) => {
  entry.d = Math.max(16, (allChars[n + 1]?.t ?? entry.t) - entry.t);
});
const typedMs = Math.round(clock);
---

<script is:inline>
  // La secuencia de apertura solo se interpreta en la primera carga, no al volver a la home navegando.
  if (!window.__heroIntroPlayed && window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    document.documentElement.classList.add('intro');
  }
  window.__heroIntroPlayed = true;
</script>

<section class="hero" data-tone="peach">
  <div class="container hero__inner">
    <p class="hero__slug script-font" style={`--chars:${slug.length}`}>
      <span class="hero__slug-text">{slug}</span><span class="hero__caret" aria-hidden="true"></span>
    </p>

    <div class="hero__title">
      <h1 class="hero__name">
        <a class="hero__name-link" href={localizedPath(lang, routes.about)} aria-label={name}>
          {nameLines.map((letters, line) => (
            <span class="hero__line" style={`--line:${line}`} aria-hidden="true">
              {letters.map(({ char, i }) => <span class="hero__char" style={`--c:${i}`}>{char}</span>)}
            </span>
          ))}
        </a>
      </h1>
      <p class="hero__role">{profile.getRole()}</p>
    </div>

    <div class="hero__mark" data-hero-mark aria-hidden="true">
      <div class="hero__stack">
        <span class="hero__sheet hero__sheet--back"></span>
        <div class="hero__page script-font" style={`--typed:${typedMs}ms`}>
          <span class="hero__brads"><i></i><i></i><i></i></span>
          <span class="hero__pageno">1.</span>
          {pageBlocks.map(({ kind, words }, b) => (
            <p class={`hero__block hero__block--${kind}`}>
              {words.map((letters, w) => (
                <>
                  <span class="hero__word">{letters.map(({ char, t, d }) => <span class="hero__ch" style={`--t:${t}ms;--d:${d}ms`}>{char}</span>)}</span>
                  {w < words.length - 1 && ' '}
                </>
              ))}
              {b === pageBlocks.length - 1 && <span class="hero__cursor"></span>}
            </p>
          ))}
        </div>
      </div>
    </div>

    <p class="hero__tagline">{profile.getTagline()}</p>

    <div class="hero__actions">
      <a class="button button--primary" href={localizedPath(lang, routes.projects)}>{t('home.ctaProjects')}</a>
      {cv && <DownloadButton file={cv} label={t('home.ctaCv')} variant="secondary" />}
      <a class="hero__contact" href={localizedPath(lang, routes.contact)}>{t('home.ctaContact')} →</a>
    </div>
  </div>
</section>

<script>
  /*
   * El asterisco atiende al lector: se inclina y se desplaza un poco hacia el puntero,
   * con inercia. Su giro lento de reposo se pausa cuando el hero sale de pantalla.
   */
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const finePointer = window.matchMedia('(pointer: fine)');
  let cleanup: (() => void) | undefined;

  function initHeroMark() {
    cleanup?.();
    cleanup = undefined;
    const mark = document.querySelector<HTMLElement>('[data-hero-mark]');
    if (!mark || reduce.matches) return;

    const visibility = new IntersectionObserver(([entry]) => {
      mark.toggleAttribute('data-offscreen', !entry.isIntersecting);
    });
    visibility.observe(mark);

    if (!finePointer.matches) {
      cleanup = () => visibility.disconnect();
      return;
    }

    let target = { x: 0, y: 0 };
    let current = { x: 0, y: 0 };
    let frame = 0;

    const tick = () => {
      current.x += (target.x - current.x) * 0.07;
      current.y += (target.y - current.y) * 0.07;
      mark.style.setProperty('--px', current.x.toFixed(4));
      mark.style.setProperty('--py', current.y.toFixed(4));
      const settled = Math.abs(target.x - current.x) < 0.001 && Math.abs(target.y - current.y) < 0.001;
      frame = settled ? 0 : requestAnimationFrame(tick);
    };

    const onMove = (event: PointerEvent) => {
      if (mark.hasAttribute('data-offscreen')) return;
      const box = mark.getBoundingClientRect();
      const cx = box.left + box.width / 2;
      const cy = box.top + box.height / 2;
      target = {
        x: Math.max(-1, Math.min(1, (event.clientX - cx) / (window.innerWidth / 2))),
        y: Math.max(-1, Math.min(1, (event.clientY - cy) / (window.innerHeight / 2))),
      };
      if (!frame) frame = requestAnimationFrame(tick);
    };

    window.addEventListener('pointermove', onMove, { passive: true });
    cleanup = () => {
      window.removeEventListener('pointermove', onMove);
      visibility.disconnect();
      cancelAnimationFrame(frame);
    };
  }

  document.addEventListener('astro:page-load', initHeroMark);

  /*
   * Al pasar el ratón por una letra del nombre, repite el gesto de la apertura: cae bajo la
   * línea de corte y vuelve a subir girando. No se reinicia mientras está en marcha.
   */
  function initNameHover() {
    if (reduce.matches || !finePointer.matches) return;
    document.querySelectorAll<HTMLElement>('.hero__char').forEach((char) => {
      if (char.dataset.hover) return;
      char.dataset.hover = 'true';
      char.addEventListener('pointerenter', () => {
        if (char.getAnimations().some((animation) => animation.playState === 'running')) return;
        char.animate(
          [
            { translate: '0 0', rotate: '0deg', easing: 'cubic-bezier(0.7, 0, 0.84, 0)' },
            { translate: '0 105%', rotate: '8deg', offset: 0.3, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' },
            { translate: '0 0', rotate: '0deg' },
          ],
          { duration: 1100 },
        );
      });
    });
  }

  document.addEventListener('astro:page-load', initNameHover);
</script>

<style>
  .hero {
    position: relative;
    padding-block: var(--space-12) var(--band-pad);
    overflow: hidden;
    overflow: clip;
  }

  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    grid-template-areas:
      'slug'
      'mark'
      'title'
      'tagline'
      'actions';
    align-items: end;
    gap: var(--space-6);
  }

  .hero__slug {
    grid-area: slug;
    position: relative;
    z-index: 1;
    margin: 0;
    font-weight: 700;
    font-size: var(--text-sm);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--cobalt);
    white-space: nowrap;
  }

  .hero__slug-text {
    display: inline-block;
  }

  .hero__caret {
    display: none;
  }

  .hero__title {
    grid-area: title;
    position: relative;
    z-index: 1;
  }

  .hero__name {
    margin: 0;
    font-size: var(--text-hero);
    font-weight: 300;
    line-height: 0.95;
    letter-spacing: 0.04em;
    view-transition-name: site-name;
  }

  /* El nombre lleva a «Sobre mí»: mismo aspecto, sin subrayado. */
  .hero__name-link {
    display: block;
    width: fit-content;
    color: inherit;
    text-decoration: none;
  }

  .hero__name-link:hover {
    color: inherit;
  }

  .hero__name-link:focus-visible {
    outline-offset: 8px;
  }

  .hero__line {
    display: block;
    width: fit-content;
    /* Recorta la entrada de las letras por abajo, dejando aire para tildes. */
    clip-path: inset(-0.4em -0.2em 0 -0.2em);
  }

  .hero__line + .hero__line {
    margin-left: 1.15em;
  }

  .hero__char {
    display: inline-block;
  }

  .hero__role {
    margin: var(--space-6) 0 0;
    margin-left: calc(1.15 * var(--text-hero));
    font-family: var(--font-display);
    font-weight: 300;
    font-size: var(--text-lg);
    letter-spacing: var(--tracking-wide);
    text-transform: lowercase;
    color: var(--cobalt);
  }

  /* Página de guion: hoja cobalto en formato carta, encuadernada, con otra hoja asomando detrás. */
  .hero__mark {
    grid-area: mark;
    justify-self: end;
    width: clamp(9.5rem, 44vw, 14rem);
    margin-right: calc(-0.5 * var(--gutter));
    margin-block: var(--space-2) var(--space-4);
    transform: perspective(1200px) rotateY(calc(var(--px, 0) * 9deg)) rotateX(calc(var(--py, 0) * -7deg));
  }

  /* Contenedor de consulta: todas las medidas de la página van en cqw (ancho de la hoja). */
  .hero__stack {
    position: relative;
    container-type: inline-size;
  }

  .hero__sheet--back {
    position: absolute;
    inset: 0;
    background: var(--taupe);
    rotate: 3.5deg;
    translate: 4% 2%;
  }

  .hero__page {
    position: relative;
    aspect-ratio: 8.5 / 11;
    /* Márgenes de una página carta real: 1.5" a la izquierda (encuadernación), 1" arriba y a la derecha. */
    padding: 11.8cqw 11.8cqw 9cqw 17.6cqw;
    overflow: hidden;
    background: var(--cobalt);
    color: var(--peach);
    font-size: 3.4cqw;
    line-height: 1.2;
    rotate: -2.5deg;
  }

  /* Agujeros de encuadernación: dejan ver el papel de la banda. */
  .hero__brads {
    position: absolute;
    left: 5.5cqw;
    top: 0;
    bottom: 0;
  }

  .hero__brads i {
    position: absolute;
    left: 0;
    width: 2.4cqw;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--peach);
  }

  .hero__brads i:nth-child(1) { top: 16%; }
  .hero__brads i:nth-child(2) { top: 50%; }
  .hero__brads i:nth-child(3) { top: 84%; }

  .hero__pageno {
    position: absolute;
    top: 5.9cqw;
    right: 11.8cqw;
  }

  /*
   * Interlineado sencillo dentro de cada bloque y una línea en blanco entre bloques, como en
   * un guion de verdad. Personaje, acotación y diálogo van pegados: son un mismo parlamento.
   * Sangrías medidas desde el margen izquierdo (1" = 11.76cqw).
   */
  .hero__block {
    margin: 0 0 1lh;
    text-wrap: wrap;
  }

  .hero__block--slug {
    font-weight: 700;
    text-transform: uppercase;
  }

  .hero__block--character {
    margin-bottom: 0;
    margin-left: 25.9cqw;
  }

  .hero__block--parenthetical {
    margin-bottom: 0;
    margin-left: 18.9cqw;
    max-width: 23.5cqw;
  }

  .hero__block--dialogue {
    margin-left: 11.8cqw;
    max-width: 41cqw;
  }

  .hero__block--transition {
    margin-bottom: 0;
    text-align: right;
  }

  .hero__ch {
    position: relative;
  }

  .hero__word {
    white-space: nowrap;
  }

  .hero__cursor {
    display: none;
  }

  .hero__tagline {
    grid-area: tagline;
    position: relative;
    z-index: 1;
    max-width: 30ch;
    margin: var(--space-4) 0 0;
    font-family: var(--font-display);
    font-weight: 300;
    font-style: italic;
    font-size: var(--text-xl);
    line-height: 1.35;
  }

  .hero__actions {
    grid-area: actions;
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    margin-top: var(--space-6);
  }

  .hero__contact {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    min-height: 48px;
    padding-inline: var(--space-2);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--cobalt);
    background: linear-gradient(currentColor, currentColor) left calc(50% + 0.9em) / 0 1px no-repeat;
    transition: background-size 450ms var(--ease-out);
  }

  .hero__contact:hover {
    background-size: calc(100% - 2 * var(--space-2)) 1px;
    background-position-x: var(--space-2);
  }

  @media (max-width: 899px) {
    .hero__role {
      margin-left: 0;
    }
  }

  @media (min-width: 900px) {
    .hero {
      padding-top: var(--space-16);
    }

    .hero__inner {
      min-height: min(50rem, calc(100svh - 9rem));
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      grid-template-rows: auto 1fr auto auto;
      grid-template-areas:
        'slug    mark'
        'title   mark'
        'tagline mark'
        'actions mark';
      column-gap: var(--space-8);
      row-gap: var(--space-4);
      align-items: start;
    }

    .hero__title {
      align-self: end;
      padding-block: var(--space-16) var(--space-4);
    }

    .hero__role {
      margin-left: calc(1.15 * var(--text-hero));
    }

    .hero__mark {
      width: clamp(21rem, 30vw, 29rem);
      align-self: center;
      justify-self: center;
      margin: 0;
    }
  }

  /*
   * Apertura (primera carga), unos 2 s:
   * 1. La slugline se teclea con un cursor de Courier que avanza con ella y parpadea al acabar.
   * 2. La página de guion cae sobre la mesa, la hoja de detrás se desliza a su sitio, y el guion
   *    se teclea como a máquina (ritmo irregular, pausas en la puntuación y entre bloques) con un
   *    cursor que viaja con las letras y se queda parpadeando tras «CORTE A:».
   * 3. SARA / ABREU sube letra a letra desde la línea de corte.
   * 4. El rol se asienta, el lema entra con un cambio de foco y las acciones llegan en cascada.
   * Firma permanente: la página se inclina en 3D hacia el puntero y se levanta con el scroll.
   */
  @media (prefers-reduced-motion: no-preference) {
    .hero__caret {
      display: inline-block;
      width: 0.62em;
      height: 1.15em;
      margin-left: 0.15em;
      vertical-align: -0.2em;
      background: currentColor;
      opacity: 0;
    }

    :global(html.intro) .hero__slug-text {
      animation: type-on var(--type-duration) steps(var(--chars), end) 120ms backwards;
    }

    :global(html.intro) .hero__caret {
      animation:
        caret-travel var(--type-duration) steps(var(--chars), end) 120ms backwards,
        caret-blink 1060ms steps(1, end) calc(120ms + var(--type-duration)) 4;
    }

    :global(html.intro) .hero__slug {
      --type-duration: min(calc(var(--chars, 24) * 28ms), 900ms);
    }

    :global(html.intro) .hero__char {
      animation: char-rise 1000ms var(--ease-out) calc(520ms + var(--c) * 42ms) backwards;
    }

    :global(html.intro) .hero__role {
      animation: settle 800ms var(--ease-out) 1150ms backwards;
    }

    :global(html.intro) .hero__tagline {
      animation: focus-pull 1100ms var(--ease-out) 1300ms backwards;
    }

    :global(html.intro) .hero__actions > :global(*) {
      animation: settle 700ms var(--ease-out) backwards;
    }

    :global(html.intro) .hero__actions > :global(:nth-child(1)) { animation-delay: 1500ms; }
    :global(html.intro) .hero__actions > :global(:nth-child(2)) { animation-delay: 1590ms; }
    :global(html.intro) .hero__actions > :global(:nth-child(3)) { animation-delay: 1680ms; }

    :global(html.intro) .hero__mark {
      animation: page-drop 1300ms var(--ease-out) 150ms backwards;
    }

    :global(html.intro) .hero__sheet--back {
      animation: sheet-slide 1600ms var(--ease-out) 250ms backwards;
    }

    :global(html.intro) .hero__ch {
      animation: key-strike 1ms linear calc(950ms + var(--t)) backwards;
    }

    /* El cursor viaja con el tecleo: se queda detrás de cada carácter hasta que cae el siguiente. */
    :global(html.intro) .hero__ch::after {
      content: '';
      position: absolute;
      left: 100%;
      top: 0.05em;
      width: 0.6em;
      height: 1.05em;
      background: currentColor;
      opacity: 0;
      animation: caret-pass var(--d) steps(1, end) calc(950ms + var(--t));
    }

    .hero__cursor {
      display: inline-block;
      width: 0.6em;
      height: 1.1em;
      margin-left: 0.2em;
      vertical-align: -0.2em;
      background: currentColor;
      opacity: 0;
    }

    :global(html.intro) .hero__cursor {
      animation: caret-blink 1060ms steps(1, end) calc(950ms + var(--typed)) 6;
    }

    @supports (animation-timeline: scroll()) {
      .hero__page {
        animation-name: page-lift;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root);
        animation-range: 0 120vh;
      }

      /* El nombre se retira despacio al bajar: la página toma el relevo. */
      .hero__title {
        animation-name: title-recede;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: scroll(root);
        animation-range: 0 90vh;
      }
    }
  }

  @keyframes caret-travel {
    from {
      translate: calc(var(--chars) * (-1ch - 0.04em)) 0;
      opacity: 1;
    }
    to {
      translate: 0 0;
      opacity: 1;
    }
  }

  @keyframes caret-blink {
    0% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }

  @keyframes char-rise {
    from {
      translate: 0 105%;
      rotate: 8deg;
    }
    to {
      translate: 0 0;
      rotate: 0deg;
    }
  }

  @keyframes focus-pull {
    from {
      opacity: 0;
      filter: blur(10px);
      translate: 0 0.3em;
    }
    to {
      opacity: 1;
      filter: blur(0);
      translate: 0 0;
    }
  }

  @keyframes page-drop {
    from {
      opacity: 0;
      translate: 0 -2.5rem;
      rotate: -7deg;
    }
    to {
      opacity: 1;
      translate: 0 0;
      rotate: 0deg;
    }
  }

  @keyframes sheet-slide {
    from {
      rotate: 0deg;
      translate: 0 0;
    }
  }

  @keyframes caret-pass {
    from,
    to {
      opacity: 1;
    }
  }

  @keyframes key-strike {
    from {
      opacity: 0;
    }
    to {
      opacity: 0;
    }
  }

  @keyframes page-lift {
    to {
      translate: 0 -3rem;
      rotate: 1.5deg;
    }
  }

  @keyframes title-recede {
    to {
      translate: 0 -2.5rem;
      opacity: 0.35;
    }
  }
</style>
