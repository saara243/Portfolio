---
import Motif from './Motif.astro';
import type { Interest } from '../modules/profile/domain/Interest';

/** Temas que la autora quiere contar: palabra grande + descripción, en filas con filete. */
interface Props {
  interests: Interest[];
  /** Cada fila se escribe al llegar a pantalla: filete, asterisco, palabra y texto (ver RevealOnScroll). */
  reveal?: boolean;
}

const { interests, reveal = false } = Astro.props;
---

{interests.length > 0 && (
  <ul class="interests">
    {interests.map((interest, i) => (
      <li class="interests__item" data-reveal={reveal ? '' : undefined} style={`--row:${i % 3}`}>
        <h3 class:list={['interests__title', { 'reveal-line': reveal }]}>
          <Motif kind="asterisk" size="0.7em" class="interests__mark" />
          {interest.getTitle()}
        </h3>
        <p class:list={['interests__text', { 'reveal-fade': reveal }]}>{interest.getDescription()}</p>
      </li>
    ))}
  </ul>
)}

<style>
  .interests {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .interests__item {
    position: relative;
    isolation: isolate;
    display: grid;
    gap: var(--space-3);
    padding-block: var(--space-8);
    border-bottom: 1px solid var(--line);
  }

  /* Hoja cobalto que barre la fila al pasar: la fila cambia de tono, como una banda. */
  .interests__item::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: -1px calc(-1 * var(--gutter));
    background: var(--cobalt);
    clip-path: inset(0 100% 0 0);
    transition: clip-path 650ms var(--ease-out);
  }

  .interests__title {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin: 0;
    font-size: var(--text-3xl);
    line-height: 1;
    overflow-wrap: anywhere;
    transition: color 400ms var(--ease-out), translate 650ms var(--ease-out);
  }

  .interests__title :global(.interests__mark) {
    color: var(--cobalt);
    transition: rotate 900ms var(--ease-out), scale 900ms var(--ease-out), color 400ms var(--ease-out);
  }

  .interests__text {
    max-width: 52ch;
    margin: 0;
    font-size: var(--text-lg);
    font-weight: 300;
    line-height: 1.6;
    transition: color 400ms var(--ease-out);
  }

  @media (hover: hover) {
    .interests__item:hover::before {
      clip-path: inset(0 0 0 0);
    }

    .interests__item:hover .interests__title,
    .interests__item:hover .interests__text,
    .interests__item:hover :global(.interests__mark) {
      color: var(--peach);
    }

    .interests__item:hover :global(.interests__mark) {
      rotate: 180deg;
      scale: 1.25;
    }

    .interests__item:hover ::selection {
      background: var(--peach);
      color: var(--cobalt);
    }
  }

  @media (min-width: 900px) {
    .interests__item {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: center;
      gap: var(--space-12);
      padding-block: var(--space-12);
    }

    @media (hover: hover) and (prefers-reduced-motion: no-preference) {
      .interests__item:hover .interests__title {
        translate: var(--space-6) 0;
      }
    }
  }

  /*
   * Revelado: el filete se traza de izquierda a derecha, el asterisco estalla rayo a rayo
   * desde el centro mientras gira hasta su sitio, la palabra sube con un corte y el texto se asienta.
   */
  @media (prefers-reduced-motion: no-preference) {
    .interests__item[data-reveal='pending'],
    .interests__item[data-reveal='in'] {
      --stagger: calc(var(--row) * 90ms);
      --line-delay: calc(var(--stagger) + 150ms);
      --fade-delay: calc(var(--stagger) + 420ms);
      border-bottom-color: transparent;
    }

    .interests__item[data-reveal='pending']::after,
    .interests__item[data-reveal='in']::after {
      content: '';
      position: absolute;
      inset: auto 0 -1px;
      height: 1px;
      background: var(--line);
      transform-origin: left;
    }

    .interests__item[data-reveal='pending']::after {
      scale: 0 1;
    }

    .interests__item[data-reveal='in']::after {
      animation: rule-draw 1200ms var(--ease-out) var(--stagger) backwards;
    }

    .interests__item[data-reveal='in'] :global(.interests__mark) {
      animation: mark-turn 1100ms var(--ease-out) var(--line-delay) backwards;
    }

    .interests__item[data-reveal='in'] :global(.motif__ray) {
      animation: ray-burst 700ms var(--ease-out) calc(var(--line-delay) + var(--i) * 35ms) backwards;
    }
  }

  @keyframes rule-draw {
    from {
      scale: 0 1;
    }
    to {
      scale: 1 1;
    }
  }

  @keyframes mark-turn {
    from {
      rotate: -180deg;
      scale: 0.3;
    }
    to {
      rotate: 0deg;
      scale: 1;
    }
  }

  @keyframes ray-burst {
    from {
      scale: 0;
    }
    to {
      scale: 1;
    }
  }
</style>
