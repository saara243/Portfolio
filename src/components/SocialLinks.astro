---
import type { SocialLink } from '../modules/profile/domain/SocialLink';

interface Props {
  links: SocialLink[];
  email?: string;
  align?: 'center' | 'start';
}

const { links, email, align = 'center' } = Astro.props;
---

<ul class:list={['social', `social--${align}`]}>
  {email && (
    <li>
      <a href={`mailto:${email}`}>{email}</a>
    </li>
  )}
  {links.map((link) => (
    <li>
      <a href={link.getUrl()} target="_blank" rel="noopener noreferrer">{link.getLabel()}</a>
    </li>
  ))}
</ul>

<style>
  .social {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-1) var(--space-8);
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--text-lg);
    font-weight: 300;
  }

  .social--start {
    justify-content: flex-start;
  }

  .social a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--accent);
    overflow-wrap: anywhere;
  }
</style>
