---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import InterestList from '../../components/InterestList.astro';
import MotivationLetter from '../../components/MotivationLetter.astro';
import QuoteBand from '../../components/QuoteBand.astro';
import RevealOnScroll from '../../components/RevealOnScroll.astro';
import ScriptCard from '../../components/ScriptCard.astro';
import SceneHeading from '../../components/SceneHeading.astro';
import { profileModule } from '../../modules/profile/application/factory';
import { scriptsModule } from '../../modules/scripts/application/factory';
import { getLangStaticPaths, localizedPath, routes, toLang, useTranslations } from '../../i18n/utils';

export const getStaticPaths = getLangStaticPaths;

const lang = toLang(Astro.params.lang);
const t = useTranslations(lang);
const profile = await profileModule.getProfile.execute({ locale: lang });
const featured = await scriptsModule.listFeaturedScripts.execute({ locale: lang });
const statement = profile.getStatement();
const motivation = profile.getMotivation();
---

<BaseLayout lang={lang} path={routes.home}>
  <Hero lang={lang} profile={profile} />

  {statement && <QuoteBand text={statement} reveal />}

  {profile.getInterests().length > 0 && (
    <section class="band" data-tone="peach">
      <div class="container">
        <SceneHeading scene={t('scene.interests')} title={t('home.interests')} size="lg" reveal />
        <InterestList interests={profile.getInterests()} reveal />
      </div>
    </section>
  )}

  {!featured.isEmpty() && (
    <section class="band" data-tone="taupe">
      <div class="container">
        <div class="featured__head">
          <SceneHeading scene={t('scene.cut')} title={t('home.featured')} size="lg" reveal />
          <a class="button" href={localizedPath(lang, routes.projects)}>{t('home.allProjects')}</a>
        </div>
        <div class="grid-cards featured__grid" data-reveal>
          {featured.toArray().map((script) => <ScriptCard lang={lang} script={script} />)}
        </div>
      </div>
    </section>
  )}

  {motivation && (
    <MotivationLetter motivation={motivation} scene={t('scene.motivation')} reveal>
      <div class="letter-actions">
        <a class="button button--primary" href={localizedPath(lang, routes.contact)}>{t('contact.write')}</a>
        <a class="button" href={localizedPath(lang, routes.about)}>{t('nav.about')}</a>
      </div>
    </MotivationLetter>
  )}

  <RevealOnScroll />
</BaseLayout>

<style>
  .featured__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-6);
    margin-bottom: var(--space-12);
  }

  .featured__head :global(.scene) {
    margin-bottom: 0;
  }

  .letter-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  /*
   * Portadas destacadas: cada una se descubre de abajo arriba, como una página que se levanta,
   * y la ficha se asienta detrás. Desfase por tarjeta, con tope para listas largas.
   */
  @media (prefers-reduced-motion: no-preference) {
    .featured__grid > :global(*) {
      --card-delay: calc(min(var(--card-i, 0), 4) * 110ms);
    }

    .featured__grid > :global(:nth-child(2)) { --card-i: 1; }
    .featured__grid > :global(:nth-child(3)) { --card-i: 2; }
    .featured__grid > :global(:nth-child(4)) { --card-i: 3; }
    .featured__grid > :global(:nth-child(n + 5)) { --card-i: 4; }

    .featured__grid[data-reveal='pending'] :global(.card__frame) {
      clip-path: inset(100% 0 0 0);
    }

    .featured__grid[data-reveal='pending'] :global(.card__link > :not(.card__frame)) {
      opacity: 0;
    }

    .featured__grid[data-reveal='in'] :global(.card__frame) {
      animation: cover-lift 1000ms var(--ease-out) var(--card-delay) backwards;
    }

    .featured__grid[data-reveal='in'] :global(.card__cover) {
      animation: cover-settle 1400ms var(--ease-out) var(--card-delay) backwards;
    }

    .featured__grid[data-reveal='in'] :global(.card__link > :not(.card__frame)) {
      animation: settle 700ms var(--ease-out) calc(var(--card-delay) + 450ms) backwards;
    }
  }

  @keyframes cover-lift {
    from {
      clip-path: inset(100% 0 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes cover-settle {
    from {
      transform: scale(1.12);
    }
    to {
      transform: scale(1);
    }
  }
</style>
