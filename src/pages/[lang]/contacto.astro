---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Motif from '../../components/Motif.astro';
import SceneHeading from '../../components/SceneHeading.astro';
import SocialLinks from '../../components/SocialLinks.astro';
import { profileModule } from '../../modules/profile/application/factory';
import { getLangStaticPaths, routes, toLang, useTranslations } from '../../i18n/utils';

export const getStaticPaths = getLangStaticPaths;

const lang = toLang(Astro.params.lang);
const t = useTranslations(lang);
const profile = await profileModule.getProfile.execute({ locale: lang });

// Si se define PUBLIC_FORMSPREE_ID se activa el formulario; si no, solo email y redes.
const formspreeId = import.meta.env.PUBLIC_FORMSPREE_ID;
---

<BaseLayout lang={lang} path={routes.contact} title={t('contact.title')}>
  <section class="band contact" data-tone="cobalt">
    <div class="container contact__inner">
      <div class="contact__head">
        <SceneHeading scene={t('scene.contact')} title={t('contact.title')} level={1} size="lg" />
        <p class="lead contact__intro">{t('contact.intro')}</p>
        <a class="contact__email" href={`mailto:${profile.getEmail()}`}>{profile.getEmail()}</a>
        <SocialLinks links={profile.getSocials()} align="start" />
        {profile.getLocation() && <p class="contact__location">{profile.getLocation()}</p>}
      </div>

      {formspreeId ? (
        <form class="contact__form" data-tone="peach" action={`https://formspree.io/f/${formspreeId}`} method="POST">
          <label>
            {t('contact.name')}
            <input name="name" type="text" autocomplete="name" required maxlength="120" />
          </label>
          <label>
            {t('contact.email')}
            <input name="email" type="email" autocomplete="email" required maxlength="200" />
          </label>
          <label>
            {t('contact.message')}
            <textarea name="message" rows="6" required maxlength="5000"></textarea>
          </label>
          <button class="button button--primary" type="submit">{t('contact.send')}</button>
        </form>
      ) : (
        <div class="contact__art">
          <Motif kind="asterisk" size="100%" class="contact__mark" />
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .contact__inner {
    display: grid;
    gap: var(--space-16);
  }

  .contact__head :global(.scene) {
    margin-bottom: var(--space-6);
  }

  .contact__intro {
    max-width: 44ch;
  }

  .contact__email {
    display: inline-block;
    margin: var(--space-6) 0 var(--space-4);
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.25rem, 0.6rem + 3.4vw, 2.75rem);
    line-height: 1.2;
    letter-spacing: 0.01em;
    overflow-wrap: anywhere;
    text-decoration-thickness: 1px;
  }

  .contact__location {
    margin: var(--space-2) 0 0;
  }

  .contact__art {
    width: clamp(6rem, 30vw, 9rem);
    aspect-ratio: 1;
    color: var(--peach);
  }

  .contact__form {
    display: grid;
    align-content: start;
    gap: var(--space-6);
    padding: clamp(1.5rem, 1rem + 3vw, 3rem);
  }

  .contact__form label {
    display: grid;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--cobalt);
  }

  .contact__form input,
  .contact__form textarea {
    width: 100%;
    padding: var(--space-3) 0;
    border: 0;
    border-bottom: 1px solid var(--cobalt);
    border-radius: 0;
    background: transparent;
    color: var(--ink);
    font: var(--text-base) / 1.5 var(--font-body);
    text-transform: none;
    letter-spacing: 0;
    caret-color: var(--cobalt);
  }

  .contact__form input:focus-visible,
  .contact__form textarea:focus-visible {
    outline: none;
    border-bottom-width: 2px;
    background: var(--peach-soft);
  }

  .contact__form textarea {
    resize: vertical;
  }

  .contact__form button {
    justify-self: start;
  }

  @media (min-width: 900px) {
    .contact {
      min-height: calc(100dvh - 4.5rem);
    }

    .contact__inner {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }

    .contact__art {
      width: min(100%, 24rem);
      justify-self: center;
      align-self: center;
    }
  }
</style>
