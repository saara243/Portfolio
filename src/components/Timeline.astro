---
import type { TimelineEntry } from '../modules/profile/domain/TimelineEntry';

interface Props {
  title: string;
  entries: TimelineEntry[];
}

const { title, entries } = Astro.props;
---

{entries.length > 0 && (
  <section class="timeline">
    <h2 class="timeline__title">{title}</h2>
    <ol class="timeline__list">
      {entries.map((entry) => (
        <li class="timeline__item">
          <p class="timeline__period script-font">{entry.getPeriod() ?? ''}</p>
          <div>
            <h3 class="timeline__entry">{entry.getTitle()}</h3>
            {entry.getPlace() && <p class="timeline__place">{entry.getPlace()}</p>}
            {entry.getDescription() && <p class="timeline__description">{entry.getDescription()}</p>}
          </div>
        </li>
      ))}
    </ol>
  </section>
)}

<style>
  .timeline {
    margin-bottom: var(--space-16);
  }

  .timeline__title {
    margin-bottom: var(--space-6);
    font-size: var(--text-xl);
  }

  .timeline__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  .timeline__item {
    display: grid;
    gap: var(--space-1);
    padding-block: var(--space-6);
    border-bottom: 1px solid var(--line);
  }

  .timeline__period {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    color: var(--accent);
  }

  .timeline__period:empty {
    display: none;
  }

  .timeline__entry {
    margin: 0;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: var(--text-lg);
    letter-spacing: 0;
    text-transform: none;
    line-height: 1.4;
    color: var(--fg);
  }

  .timeline__place {
    margin: var(--space-1) 0 0;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--accent);
  }

  .timeline__description {
    margin: var(--space-2) 0 0;
    font-weight: 300;
  }

  @media (min-width: 768px) {
    .timeline__item {
      grid-template-columns: 11rem 1fr;
      gap: var(--space-8);
    }

    .timeline__period:empty {
      display: block;
    }
  }
</style>
