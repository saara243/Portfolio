---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SceneHeading from '../../../components/SceneHeading.astro';
import ScriptCard from '../../../components/ScriptCard.astro';
import ScriptFilters from '../../../components/ScriptFilters.astro';
import ScriptToScreen from '../../../components/ScriptToScreen.astro';
import { profileModule } from '../../../modules/profile/application/factory';
import { scriptsModule } from '../../../modules/scripts/application/factory';
import { getLangStaticPaths, routes, toLang, useTranslations } from '../../../i18n/utils';

export const getStaticPaths = getLangStaticPaths;

const lang = toLang(Astro.params.lang);
const t = useTranslations(lang);
const scripts = await scriptsModule.listScripts.execute({ locale: lang });
const profile = await profileModule.getProfile.execute({ locale: lang });
// Dramaturgia es un formato más del filtro, siempre al final (después de serie, largo y corto).
// Subgéneros («Comedia musical absurda») cuentan dentro de su género («Comedia») y no llevan filtro propio.
const allGenres = scripts.genres();
const genres = allGenres.filter((g) => !allGenres.some((o) => o.getKey() !== g.getKey() && g.getKey().startsWith(`${o.getKey()}-`)));
const formats = scripts.formats().sort((a, b) => Number(a.getValue() === 'theatre') - Number(b.getValue() === 'theatre'));
---

<BaseLayout lang={lang} path={routes.projects} title={t('projects.title')} description={t('projects.intro')}>
  <section class="band" data-tone="peach">
    <div class="container">
    <div class="projects-head">
      <div class="projects-head__text">
        <SceneHeading scene={t('scene.projects')} title={t('projects.title')} level={1} size="lg" />
        <p class="reading lead intro">{t('projects.intro')}</p>
      </div>
      <div class="projects-head__stage">
        <ScriptToScreen lang={lang} scripts={scripts.toArray()} author={profile.getName()} />
      </div>
    </div>

    {!scripts.isEmpty() && (
      <>
        <ScriptFilters lang={lang} formats={formats} genres={genres} />

        <div class="grid-cards" data-script-results>
          {scripts.toArray().map((script) => <ScriptCard lang={lang} script={script} />)}
        </div>
        <p class="empty" data-script-empty hidden>{t('projects.empty')}</p>
      </>
    )}
    </div>
  </section>

</BaseLayout>

<style>
  .projects-head {
    display: grid;
    gap: var(--space-8);
    margin-bottom: var(--space-12);
  }

  .intro {
    margin: calc(-1 * var(--space-6)) 0 0;
  }

  @media (min-width: 900px) {
    .projects-head {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      align-items: center;
      gap: var(--space-16);
    }
  }

  .empty {
    font-family: var(--font-script);
    font-weight: 700;
    text-transform: uppercase;
    color: var(--accent);
  }
</style>
