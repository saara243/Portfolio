---
import type { TimelineEntry } from '../modules/profile/domain/TimelineEntry';

interface Props {
  title: string;
  entries: TimelineEntry[];
}

const { title, entries } = Astro.props;
---

{entries.length > 0 && (
  <section class="timeline">
    <h2 class="timeline__title">{title}</h2>
    <ol class="timeline__list">
      {entries.map((entry) => (
        <li class="timeline__item">
          {entry.getPeriod() && <p class="timeline__period script-font">{entry.getPeriod()}</p>}
          <div>
            <h3 class="timeline__entry">{entry.getTitle()}</h3>
            {entry.getPlace() && <p class="timeline__place">{entry.getPlace()}</p>}
            {entry.getDescription() && <p class="timeline__description">{entry.getDescription()}</p>}
          </div>
        </li>
      ))}
    </ol>
  </section>
)}

<style>
  .timeline {
    margin-bottom: var(--space-12);
  }

  .timeline__title {
    font-size: var(--text-xl);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-line);
  }

  .timeline__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-6);
  }

  .timeline__item {
    display: grid;
    gap: var(--space-1);
  }

  .timeline__period {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-accent);
  }

  .timeline__entry {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--text-base);
    margin: 0;
  }

  .timeline__place,
  .timeline__description {
    margin: 0;
    color: var(--color-muted);
  }

  @media (min-width: 768px) {
    .timeline__item {
      grid-template-columns: 10rem 1fr;
      gap: var(--space-6);
    }
  }
</style>
