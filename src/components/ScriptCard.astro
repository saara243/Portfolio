---
import CoverArt from './CoverArt.astro';
import type { Script } from '../modules/scripts/domain/Script';
import type { UiKey } from '../i18n/ui';
import { localizedPath, routes, useTranslations, withBase, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  script: Script;
}

const { lang, script } = Astro.props;
const t = useTranslations(lang);
const cover = script.getCover();
const coverArt = script.getCoverArt();
const format = script.getFormat().getValue();
const genreKeys = script.getGenres().map((genre) => genre.getKey()).join(' ');
const genres = script.getGenres().map((genre) => genre.getLabel()).join(' · ');
---

<article class="card" data-script-card data-format={format} data-genres={genreKeys}>
  <a class="card__link" href={localizedPath(lang, routes.project(script.getSlug()))}>
    <div class="card__frame">
      {cover ? (
        <img
          class="card__cover"
          src={withBase(cover)}
          alt=""
          width="600"
          height="800"
          loading="lazy"
          transition:name={`cover-${script.getSlug()}`}
        />
      ) : coverArt ? (
        <CoverArt kind={coverArt} title={script.getTitle()} class="card__cover" transition:name={`cover-${script.getSlug()}`} />
      ) : (
        <span class="card__cover card__cover--empty" aria-hidden="true">{script.getTitle()}</span>
      )}
    </div>
    <p class="card__meta script-font">
      {t(`format.${format}` as UiKey)} · {script.getDisplayDate()}
    </p>
    <h3 class="card__title">{script.getTitle()}</h3>
    {genres && <p class="card__genres">{genres}</p>}
    <p class="card__logline">{script.getLogline()}</p>
    <span class="card__more">{t('projects.read')} <span aria-hidden="true">→</span></span>
  </a>
</article>

<style>
  .card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .card__frame {
    overflow: hidden;
    margin-bottom: var(--space-4);
    background: var(--cobalt);
  }

  .card__cover {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    transition: scale 700ms var(--ease-out), opacity 300ms var(--ease-out);
  }

  .card__cover--empty {
    display: grid;
    place-items: center;
    padding: var(--space-6);
    font-family: var(--font-display);
    font-weight: 300;
    font-size: var(--text-xl);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    text-align: center;
    color: var(--peach);
  }

  .card__link:hover .card__cover {
    scale: 1.035;
    opacity: 0.92;
  }

  .card__meta {
    margin: 0 0 var(--space-2);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    color: var(--accent);
  }

  .card__title {
    margin: 0 0 var(--space-2);
    font-size: var(--text-xl);
    font-weight: 400;
  }

  .card__genres {
    margin: 0 0 var(--space-3);
    font-size: var(--text-sm);
    color: var(--muted);
  }

  .card__logline {
    flex: 1;
    margin: 0 0 var(--space-4);
    font-size: var(--text-base);
    font-weight: 300;
    line-height: 1.6;
  }

  .card__more {
    align-self: start;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--accent);
    border-bottom: 1px solid var(--line);
    padding-bottom: var(--space-1);
    transition: border-color var(--transition);
  }

  .card__link:hover .card__more {
    border-color: var(--accent);
  }

  .card__link:hover .card__title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
</style>
