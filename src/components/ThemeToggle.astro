---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<button class="theme-toggle" type="button" aria-label={label} title={label} data-theme-toggle>
  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
    <path fill="currentColor" d="M12 3a9 9 0 1 0 0 18V3Z" />
    <circle cx="12" cy="12" r="8.25" fill="none" stroke="currentColor" stroke-width="1.5" />
  </svg>
</button>

<script>
  function currentTheme(): 'light' | 'dark' {
    const forced = document.documentElement.dataset.theme;
    if (forced === 'light' || forced === 'dark') return forced;
    return matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }

  function initThemeToggle() {
    document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
      const next = currentTheme() === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        // Sin almacenamiento (modo privado): el cambio dura solo esta visita.
      }
    });
  }

  document.addEventListener('astro:page-load', initThemeToggle);
  // Mantener el tema elegido al navegar con View Transitions.
  document.addEventListener('astro:after-swap', () => {
    try {
      const theme = localStorage.getItem('theme');
      if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
    } catch {}
  });
</script>

<style>
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: none;
    color: inherit;
    cursor: pointer;
  }

  .theme-toggle:hover {
    color: var(--color-accent);
  }
</style>
