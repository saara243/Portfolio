---
/** Encabezado de sección con estética de "slugline" de guion (INT. LUGAR — DÍA). */
interface Props {
  scene: string;
  title?: string;
  level?: 1 | 2;
}

const { scene, title, level = 2 } = Astro.props;
const Heading = level === 1 ? 'h1' : 'h2';
---

<div class="scene">
  <p class="scene__slug script-font">{scene}</p>
  {title && <Heading class="scene__title">{title}</Heading>}
</div>

<style>
  .scene {
    margin-bottom: var(--space-8);
  }

  .scene__slug {
    margin: 0 0 var(--space-2);
    font-weight: 700;
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .scene__title {
    font-size: var(--text-2xl);
    margin: 0;
  }
</style>
