---
import SocialLinks from './SocialLinks.astro';
import type { Profile } from '../modules/profile/domain/Profile';
import { useTranslations, type Lang } from '../i18n/utils';

interface Props {
  lang: Lang;
  profile: Profile;
}

const { lang, profile } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <p class="footer__fade script-font" aria-hidden="true">{t('404.title')}</p>
    <SocialLinks links={profile.getSocials()} email={profile.getEmail()} />
    <p class="footer__legal">
      © {year} {profile.getName()}. {t('footer.rights')}<br />
      <small>{t('footer.ip')}</small>
    </p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-line);
    padding-block: var(--space-12);
    margin-top: var(--space-16);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .footer__inner {
    display: grid;
    gap: var(--space-6);
  }

  .footer__fade {
    margin: 0;
    color: var(--color-ink);
    text-align: right;
    text-transform: uppercase;
  }

  .footer__legal {
    margin: 0;
    max-width: var(--reading-width);
  }
</style>
